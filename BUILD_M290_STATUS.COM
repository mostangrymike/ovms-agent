$!===========================================================
$! BUILD_M290_STATUS.COM - Focused subprocess status regression
$!===========================================================
$ SET NOON
$
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
F$PARSE(PROCEDURE,,,"DIRECTORY")
$ FINAL_STATUS = 1
$
$ SET DEFAULT 'PROJECT_DIR'
$ IF F$SEARCH("[]BUILD.DIR;*") .EQS. "" THEN CREATE/DIRECTORY [.BUILD]
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ CC/OBJECT=[.BUILD]M290_STATUS_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]M290_STATUS_TEST.C
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ LINK/EXECUTABLE=[.BUILD]M290_STATUS_TEST.EXE -
[.BUILD]M290_STATUS_TEST.OBJ
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ RUN [.BUILD]M290_STATUS_TEST
$ FINAL_STATUS = $STATUS
$ GOTO FINISH
$
$ FAIL:
$ FINAL_STATUS = $STATUS
$
$ FINISH:
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 'FINAL_STATUS'
