$!===========================================================
$! BUILD_OPENAI_MODULES.COM
$! Compile the modular OpenAI/agent subsystem.
$!===========================================================
$ SET NOON
$ FINAL_STATUS = 1
$
$ WRITE SYS$OUTPUT "Compiling modular OpenAI subsystem..."
$
$ CC/OBJECT=[.BUILD]OPENAI_REPAIR.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]OPENAI_REPAIR.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]OPENAI_TOOL_SCHEMA.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]OPENAI_TOOL_SCHEMA.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]OPENAI_JSON_WRITE.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]OPENAI_JSON_WRITE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]OPENAI_PROMPTS.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]OPENAI_PROMPTS.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_STATE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_STATE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_JSON.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_JSON.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_JSON_PARSE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_JSON_PARSE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_REQUEST.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_REQUEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_REQUEST_BASIC.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_REQUEST_BASIC.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_TRANSPORT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_TRANSPORT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_RESPONSE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_RESPONSE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_TOOLS.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_TOOLS.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_TOOL_REGISTRY.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_TOOL_REGISTRY.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_AGENT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_AGENT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_AGENT_LOOP.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_AGENT_LOOP.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_BUILD.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_BUILD.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_CREATE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_CREATE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_RETRY.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_RETRY.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_STATUS.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_STATUS.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_EXECUTE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_EXECUTE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_PLAN.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_PLAN.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_LOG.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_LOG.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_PARITY.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_PARITY.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! M256 compiles the mature session implementation through a thin wrapper
$! that preserves all existing behavior while clearing stale plan approval
$! after a successful persistent-session resume.
$ CC/OBJECT=[.BUILD]OPENAI_SESSION.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_SESSION_M256.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_TRANSCRIPT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_TRANSCRIPT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_AUTO.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_AUTO.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_CONTEXT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_CONTEXT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_INSTRUCTIONS.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_INSTRUCTIONS.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_PROJECT_MAP.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_PROJECT_MAP.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_GIT_CONTEXT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_GIT_CONTEXT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_PATCH.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_PATCH.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_TOOL_RESULT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_TOOL_RESULT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]RMS_WRITE.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]RMS_WRITE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]EDIT_TXN.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]EDIT_TXN.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]OPENAI_REQUEST_AGENT.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]OPENAI_REQUEST_AGENT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]OPENAI_REQUEST_BUILD.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]OPENAI_REQUEST_BUILD.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ WRITE SYS$OUTPUT "Modular OpenAI subsystem compiled successfully."
$ EXIT 1
$
$ COMPILE_ERROR:
$ FINAL_STATUS = $STATUS
$ WRITE SYS$ERROR "Modular OpenAI subsystem compilation failed."
$ EXIT 'FINAL_STATUS'