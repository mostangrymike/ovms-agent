$ SET NOON
$ IF P1 .EQS. ""
$ THEN
$     WRITE SYS$OUTPUT "Usage: @GIT_RESTORE ""path1,path2,..."""
$     EXIT %X10000002
$ ENDIF
$
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DEVICE = F$PARSE(PROCEDURE,,,"DEVICE")
$ PROJECT_DIRECTORY = F$PARSE(PROCEDURE,,,"DIRECTORY")
$ PROJECT_DIR = PROJECT_DEVICE + PROJECT_DIRECTORY
$ BUILD_DIR = PROJECT_DEVICE + -
              F$EXTRACT(0,F$LENGTH(PROJECT_DIRECTORY)-1,PROJECT_DIRECTORY) + -
              ".BUILD]"
$ IMAGE = F$PARSE("OVMS_AGENT.EXE", BUILD_DIR)
$
$ IF F$SEARCH(IMAGE) .EQS. ""
$ THEN
$     WRITE SYS$OUTPUT "%OVMS-AGENT-E-NOIMAGE, executable not found"
$     WRITE SYS$OUTPUT "Expected image: ", IMAGE
$     WRITE SYS$OUTPUT "Run @BUILD first."
$     EXIT %X10000002
$ ENDIF
$
$ INPUT_FILE = "SYS$LOGIN:OVMS_AGENT_GIT_BATCH.IN"
$ DELETE/NOLOG 'INPUT_FILE';*
$ OPEN/WRITE GIT_INPUT 'INPUT_FILE'
$ WRITE GIT_INPUT "AGENT/APPROVAL/SET workspace"
$ WRITE GIT_INPUT "AGENT/TOOL/RUN GITRESTORE ''P1'"
$ WRITE GIT_INPUT "y"
$ WRITE GIT_INPUT "QUIT"
$ CLOSE GIT_INPUT
$
$ DEFINE OVMS_AGENT_WRITE_ENABLED YES
$ DEFINE/USER SYS$INPUT 'INPUT_FILE'
$ RUN 'IMAGE'
$ RUN_STATUS = $STATUS
$ DELETE/NOLOG 'INPUT_FILE';*
$ EXIT RUN_STATUS
