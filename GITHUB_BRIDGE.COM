$! GITHUB_BRIDGE.COM - OVMS Agent GitHub PR service bridge
$ SET NOON
$
$ HEADERS = "SYS$LOGIN:OVMS_AGENT_GH_API_HEADERS.TMP"
$ BODYFILE = "SYS$LOGIN:OVMS_AGENT_GH_API_BODY.TMP"
$ APIRESP = "SYS$LOGIN:OVMS_AGENT_GH_API_RESPONSE.TMP"
$ GOSUB CLEANUP
$
$ IF P1 .EQS. "" THEN GOTO FAIL_NO_RESPONSE
$ IF P2 .EQS. "" THEN GOTO FAIL_NO_RESPONSE
$
$ OPEN/READ/ERROR=BAD_REQUEST REQ 'P1'
$ READ/END_OF_FILE=BAD_REQUEST_CLOSE/ERROR=BAD_REQUEST_CLOSE REQ OP_LINE
$ READ/END_OF_FILE=BAD_REQUEST_CLOSE/ERROR=BAD_REQUEST_CLOSE REQ ARG_LINE
$ CLOSE REQ
$
$ IF OP_LINE .NES. "operation=pr" THEN GOTO BAD_REQUEST
$ IF F$LENGTH(ARG_LINE) .LT. 10 THEN GOTO BAD_REQUEST
$ IF F$EXTRACT(0,10,ARG_LINE) .NES. "arguments=" THEN GOTO BAD_REQUEST
$ ARGUMENTS = F$EXTRACT(10,F$LENGTH(ARG_LINE)-10,ARG_LINE)
$ ARGUMENTS = F$EDIT(ARGUMENTS,"COMPRESS,TRIM")
$ ACTION = F$EDIT(F$ELEMENT(0," ",ARGUMENTS),"TRIM,UPCASE")
$
$ IF ACTION .EQS. "HELP" THEN GOTO DO_HELP
$ IF ACTION .EQS. "LIST" THEN GOTO LOAD_PROFILE
$ IF ACTION .EQS. "CREATE" THEN GOTO LOAD_PROFILE
$ GOTO BAD_ACTION
$
$DO_HELP:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "pr help"
$ WRITE RESP "pr list"
$ WRITE RESP "pr create BASE HEAD ISSUE TITLE"
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000001
$
$LOAD_PROFILE:
$ ACTIVE = ""
$ REPO = ""
$ TOKEN = ""
$ IF F$SEARCH("SYS$LOGIN:OVMS_AGENT_GITHUB.DAT;*") .EQS. "" THEN GOTO PROFILE_ERROR
$ OPEN/READ/ERROR=PROFILE_ERROR CFG SYS$LOGIN:OVMS_AGENT_GITHUB.DAT
$
$FIND_ACTIVE:
$ READ/END_OF_FILE=PROFILE_ERROR_CLOSE/ERROR=PROFILE_ERROR_CLOSE CFG CFG_LINE
$ IF F$LENGTH(CFG_LINE) .LT. 7 THEN GOTO FIND_ACTIVE
$ IF F$EXTRACT(0,7,CFG_LINE) .NES. "active=" THEN GOTO FIND_ACTIVE
$ ACTIVE = F$EDIT(F$EXTRACT(7,F$LENGTH(CFG_LINE)-7,CFG_LINE),"TRIM")
$ CLOSE CFG
$ IF ACTIVE .EQS. "" THEN GOTO PROFILE_ERROR
$
$ TARGET_SECTION = "[github " + ACTIVE + "]"
$ OPEN/READ/ERROR=PROFILE_ERROR CFG SYS$LOGIN:OVMS_AGENT_GITHUB.DAT
$
$FIND_SECTION:
$ READ/END_OF_FILE=PROFILE_ERROR_CLOSE/ERROR=PROFILE_ERROR_CLOSE CFG CFG_LINE
$ IF CFG_LINE .NES. TARGET_SECTION THEN GOTO FIND_SECTION
$
$IN_SECTION:
$ READ/END_OF_FILE=PROFILE_DONE/ERROR=PROFILE_ERROR_CLOSE CFG CFG_LINE
$ IF F$LENGTH(CFG_LINE) .EQ. 0 THEN GOTO PROFILE_DONE
$ FIRST_CHAR = F$EXTRACT(0,1,CFG_LINE)
$ IF FIRST_CHAR .EQS. "[" THEN GOTO PROFILE_DONE
$ IF F$LENGTH(CFG_LINE) .LT. 5 THEN GOTO CHECK_TOKEN
$ IF F$EXTRACT(0,5,CFG_LINE) .EQS. "repo=" THEN REPO = F$EXTRACT(5,F$LENGTH(CFG_LINE)-5,CFG_LINE)
$
$CHECK_TOKEN:
$ IF F$LENGTH(CFG_LINE) .LT. 6 THEN GOTO IN_SECTION
$ IF F$EXTRACT(0,6,CFG_LINE) .EQS. "token=" THEN TOKEN = F$EXTRACT(6,F$LENGTH(CFG_LINE)-6,CFG_LINE)
$ GOTO IN_SECTION
$
$PROFILE_DONE:
$ CLOSE CFG
$ REPO = F$EDIT(REPO,"TRIM")
$ TOKEN = F$EDIT(TOKEN,"TRIM")
$ IF REPO .EQS. "" THEN GOTO PROFILE_ERROR
$ IF TOKEN .EQS. "" THEN GOTO PROFILE_ERROR
$ IF ACTION .EQS. "LIST" THEN GOTO DO_LIST
$ IF ACTION .EQS. "CREATE" THEN GOTO DO_CREATE
$ GOTO BAD_ACTION
$
$DO_LIST:
$ GOSUB MAKE_HEADERS
$ URL = "https:" + "//api.github.com/repos/" + REPO + "/pulls?state=open&per_page=5"
$ curl --silent --show-error --fail --output 'APIRESP' --header @'HEADERS' 'URL'
$ CURL_STATUS = $STATUS
$ IF (CURL_STATUS .AND. 1) .EQ. 0 THEN GOTO CURL_ERROR
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub PR list request succeeded."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000001
$
$DO_CREATE:
$ BASE = F$ELEMENT(1," ",ARGUMENTS)
$ HEAD = F$ELEMENT(2," ",ARGUMENTS)
$ ISSUE = F$ELEMENT(3," ",ARGUMENTS)
$ TITLE = F$ELEMENT(4," ",ARGUMENTS)
$ EXTRA = F$ELEMENT(5," ",ARGUMENTS)
$ IF BASE .EQS. " " THEN GOTO CREATE_USAGE
$ IF HEAD .EQS. " " THEN GOTO CREATE_USAGE
$ IF ISSUE .EQS. " " THEN GOTO CREATE_USAGE
$ IF TITLE .EQS. " " THEN GOTO CREATE_USAGE
$ IF BASE .EQS. "" THEN GOTO CREATE_USAGE
$ IF HEAD .EQS. "" THEN GOTO CREATE_USAGE
$ IF ISSUE .EQS. "" THEN GOTO CREATE_USAGE
$ IF TITLE .EQS. "" THEN GOTO CREATE_USAGE
$ IF EXTRA .NES. " " THEN GOTO CREATE_USAGE
$
$ OPEN/WRITE/ERROR=NETWORK_ERROR BODY 'BODYFILE'
$ DQ = """"
$ JSON = "{" + DQ + "title" + DQ + ":" + DQ + TITLE + DQ + "," + DQ + "head" + DQ + ":" + DQ + HEAD + DQ + "," + DQ + "base" + DQ + ":" + DQ + BASE + DQ + "," + DQ + "body" + DQ + ":" + DQ + "Closes #" + ISSUE + DQ + "}"
$ WRITE BODY JSON
$ CLOSE BODY
$ BODY_STATUS = $STATUS
$ IF (BODY_STATUS .AND. 1) .EQ. 0 THEN GOTO NETWORK_ERROR
$ SET FILE/PROTECTION=(S:RWED,O:RWED,G,W) 'BODYFILE'
$
$ GOSUB MAKE_HEADERS
$ URL = "https:" + "//api.github.com/repos/" + REPO + "/pulls"
$ curl --silent --show-error --request POST --output 'APIRESP' --header @'HEADERS' --data-binary @'BODYFILE' 'URL'
$ CURL_STATUS = $STATUS
$ IF (CURL_STATUS .AND. 1) .EQ. 0 THEN GOTO CURL_ERROR
$ SEARCH/NOHEADING/OUTPUT=NL: 'APIRESP' """html_url"""
$ API_SEVERITY = $SEVERITY
$ IF API_SEVERITY .NE. 1 THEN GOTO CREATE_API_ERROR
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub PR create request succeeded."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000001
$
$CREATE_API_ERROR:
$ WRITE SYS$OUTPUT "GitHub API error response:"
$ TYPE 'APIRESP'
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$MAKE_HEADERS:
$ IF F$SEARCH(HEADERS+";*") .NES. "" THEN DELETE/NOLOG 'HEADERS';*
$ OPEN/WRITE/ERROR=NETWORK_ERROR HDR 'HEADERS'
$ WRITE HDR "Authorization: Bearer ''TOKEN'"
$ WRITE HDR "Accept: application/vnd.github+json"
$ WRITE HDR "X-GitHub-Api-Version: 2022-11-28"
$ WRITE HDR "Content-Type: application/json"
$ CLOSE HDR
$ HEADER_STATUS = $STATUS
$ IF (HEADER_STATUS .AND. 1) .EQ. 0 THEN GOTO NETWORK_ERROR
$ SET FILE/PROTECTION=(S:RWED,O:RWED,G,W) 'HEADERS'
$ PROTECT_STATUS = $STATUS
$ IF (PROTECT_STATUS .AND. 1) .EQ. 0 THEN GOTO NETWORK_ERROR
$ RETURN
$
$CREATE_USAGE:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "Usage: pr create BASE HEAD ISSUE TITLE"
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$CURL_ERROR:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub API request failed."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$NETWORK_ERROR:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub bridge network setup failed."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$PROFILE_ERROR_CLOSE:
$ CLOSE CFG
$
$PROFILE_ERROR:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub profile is missing or incomplete."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$BAD_REQUEST_CLOSE:
$ CLOSE REQ
$
$BAD_REQUEST:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "Invalid GitHub PR bridge request."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$BAD_ACTION:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "Unsupported GitHub PR action."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$FAIL_NO_RESPONSE:
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$CLEANUP:
$ IF F$SEARCH(HEADERS+";*") .NES. "" THEN DELETE/NOLOG 'HEADERS';*
$ IF F$SEARCH(BODYFILE+";*") .NES. "" THEN DELETE/NOLOG 'BODYFILE';*
$ IF F$SEARCH(APIRESP+";*") .NES. "" THEN DELETE/NOLOG 'APIRESP';*
$ TOKEN = ""
$ RETURN
