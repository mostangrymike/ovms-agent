$! GITHUB_BRIDGE.COM - OVMS Agent GitHub PR/issue service bridge
$ SET NOON
$
$ HEADERS = "SYS$LOGIN:OVMS_AGENT_GH_API_HEADERS.TMP"
$ BODYFILE = "SYS$LOGIN:OVMS_AGENT_GH_API_BODY.TMP"
$ APIRESP = "SYS$LOGIN:OVMS_AGENT_GH_API_RESPONSE.TMP"
$ GOSUB CLEANUP
$
$ IF P1 .EQS. "" THEN GOTO FAIL_NO_RESPONSE
$ IF P2 .EQS. "" THEN GOTO FAIL_NO_RESPONSE
$
$ OPEN/READ/ERROR=BAD_REQUEST REQ 'P1'
$ READ/END_OF_FILE=BAD_REQUEST_CLOSE/ERROR=BAD_REQUEST_CLOSE REQ OP_LINE
$ READ/END_OF_FILE=BAD_REQUEST_CLOSE/ERROR=BAD_REQUEST_CLOSE REQ ARG_LINE
$ CLOSE REQ
$
$ OPERATION = ""
$ IF OP_LINE .EQS. "operation=pr" THEN OPERATION = "PR"
$ IF OP_LINE .EQS. "operation=issues" THEN OPERATION = "ISSUES"
$ IF OPERATION .EQS. "" THEN GOTO BAD_REQUEST
$ IF F$LENGTH(ARG_LINE) .LT. 10 THEN GOTO BAD_REQUEST
$ IF F$EXTRACT(0,10,ARG_LINE) .NES. "arguments=" THEN GOTO BAD_REQUEST
$ ARGUMENTS = F$EXTRACT(10,F$LENGTH(ARG_LINE)-10,ARG_LINE)
$ ARGUMENTS = F$EDIT(ARGUMENTS,"COMPRESS,TRIM")
$ ACTION = F$EDIT(F$ELEMENT(0," ",ARGUMENTS),"TRIM,UPCASE")
$
$ IF OPERATION .EQS. "PR" THEN GOTO DISPATCH_PR
$ IF OPERATION .EQS. "ISSUES" THEN GOTO DISPATCH_ISSUES
$ GOTO BAD_REQUEST
$
$DISPATCH_PR:
$ IF ACTION .EQS. "HELP" THEN GOTO DO_PR_HELP
$ IF ACTION .EQS. "LIST" THEN GOTO LOAD_PROFILE
$ IF ACTION .EQS. "CREATE" THEN GOTO LOAD_PROFILE
$ GOTO BAD_ACTION
$
$DISPATCH_ISSUES:
$ IF ACTION .EQS. "HELP" THEN GOTO DO_ISSUES_HELP
$ IF ACTION .EQS. "LIST" THEN GOTO LOAD_PROFILE
$ IF ACTION .EQS. "CREATE" THEN GOTO LOAD_PROFILE
$ GOTO BAD_ACTION
$
$DO_PR_HELP:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "pr help"
$ WRITE RESP "pr list"
$ WRITE RESP "pr create BASE HEAD ISSUE TITLE"
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000001
$
$DO_ISSUES_HELP:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "issues help"
$ WRITE RESP "issues list [open|closed|all]"
$ WRITE RESP "issues create TITLE"
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000001
$
$LOAD_PROFILE:
$ ACTIVE = ""
$ REPO = ""
$ TOKEN = ""
$ IF F$SEARCH("SYS$LOGIN:OVMS_AGENT_GITHUB.DAT;*") .EQS. "" THEN GOTO PROFILE_ERROR
$ OPEN/READ/ERROR=PROFILE_ERROR CFG SYS$LOGIN:OVMS_AGENT_GITHUB.DAT
$
$FIND_ACTIVE:
$ READ/END_OF_FILE=PROFILE_ERROR_CLOSE/ERROR=PROFILE_ERROR_CLOSE CFG CFG_LINE
$ IF F$LENGTH(CFG_LINE) .LT. 7 THEN GOTO FIND_ACTIVE
$ IF F$EXTRACT(0,7,CFG_LINE) .NES. "active=" THEN GOTO FIND_ACTIVE
$ ACTIVE = F$EDIT(F$EXTRACT(7,F$LENGTH(CFG_LINE)-7,CFG_LINE),"TRIM")
$ CLOSE CFG
$ IF ACTIVE .EQS. "" THEN GOTO PROFILE_ERROR
$
$ TARGET_SECTION = "[github " + ACTIVE + "]"
$ OPEN/READ/ERROR=PROFILE_ERROR CFG SYS$LOGIN:OVMS_AGENT_GITHUB.DAT
$
$FIND_SECTION:
$ READ/END_OF_FILE=PROFILE_ERROR_CLOSE/ERROR=PROFILE_ERROR_CLOSE CFG CFG_LINE
$ IF CFG_LINE .NES. TARGET_SECTION THEN GOTO FIND_SECTION
$
$IN_SECTION:
$ READ/END_OF_FILE=PROFILE_DONE/ERROR=PROFILE_ERROR_CLOSE CFG CFG_LINE
$ IF F$LENGTH(CFG_LINE) .EQ. 0 THEN GOTO PROFILE_DONE
$ FIRST_CHAR = F$EXTRACT(0,1,CFG_LINE)
$ IF FIRST_CHAR .EQS. "[" THEN GOTO PROFILE_DONE
$ IF F$LENGTH(CFG_LINE) .LT. 5 THEN GOTO CHECK_TOKEN
$ IF F$EXTRACT(0,5,CFG_LINE) .EQS. "repo=" THEN REPO = F$EXTRACT(5,F$LENGTH(CFG_LINE)-5,CFG_LINE)
$
$CHECK_TOKEN:
$ IF F$LENGTH(CFG_LINE) .LT. 6 THEN GOTO IN_SECTION
$ IF F$EXTRACT(0,6,CFG_LINE) .EQS. "token=" THEN TOKEN = F$EXTRACT(6,F$LENGTH(CFG_LINE)-6,CFG_LINE)
$ GOTO IN_SECTION
$
$PROFILE_DONE:
$ CLOSE CFG
$ REPO = F$EDIT(REPO,"TRIM")
$ TOKEN = F$EDIT(TOKEN,"TRIM")
$ IF REPO .EQS. "" THEN GOTO PROFILE_ERROR
$ IF TOKEN .EQS. "" THEN GOTO PROFILE_ERROR
$ IF OPERATION .EQS. "PR" THEN GOTO PROFILE_PR
$ IF OPERATION .EQS. "ISSUES" THEN GOTO PROFILE_ISSUES
$ GOTO BAD_ACTION
$
$PROFILE_PR:
$ IF ACTION .EQS. "LIST" THEN GOTO DO_PR_LIST
$ IF ACTION .EQS. "CREATE" THEN GOTO DO_PR_CREATE
$ GOTO BAD_ACTION
$
$PROFILE_ISSUES:
$ IF ACTION .EQS. "LIST" THEN GOTO DO_ISSUES_LIST
$ IF ACTION .EQS. "CREATE" THEN GOTO DO_ISSUES_CREATE
$ GOTO BAD_ACTION
$
$DO_PR_LIST:
$ GOSUB MAKE_HEADERS
$ URL = "https:" + "//api.github.com/repos/" + REPO + "/pulls?state=open&per_page=5"
$ curl --silent --show-error --fail --output 'APIRESP' --header @'HEADERS' 'URL'
$ CURL_STATUS = $STATUS
$ IF (CURL_STATUS .AND. 1) .EQ. 0 THEN GOTO CURL_ERROR
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub PR list request succeeded."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000001
$
$DO_PR_CREATE:
$ BASE = F$ELEMENT(1," ",ARGUMENTS)
$ HEAD = F$ELEMENT(2," ",ARGUMENTS)
$ ISSUE = F$ELEMENT(3," ",ARGUMENTS)
$ TITLE = F$ELEMENT(4," ",ARGUMENTS)
$ EXTRA = F$ELEMENT(5," ",ARGUMENTS)
$ IF BASE .EQS. " " THEN GOTO PR_CREATE_USAGE
$ IF HEAD .EQS. " " THEN GOTO PR_CREATE_USAGE
$ IF ISSUE .EQS. " " THEN GOTO PR_CREATE_USAGE
$ IF TITLE .EQS. " " THEN GOTO PR_CREATE_USAGE
$ IF BASE .EQS. "" THEN GOTO PR_CREATE_USAGE
$ IF HEAD .EQS. "" THEN GOTO PR_CREATE_USAGE
$ IF ISSUE .EQS. "" THEN GOTO PR_CREATE_USAGE
$ IF TITLE .EQS. "" THEN GOTO PR_CREATE_USAGE
$ IF EXTRA .NES. " " THEN GOTO PR_CREATE_USAGE
$
$ CREATE/FDL="RECORD;FORMAT STREAM_LF" 'BODYFILE'
$ CREATE_STATUS = $STATUS
$ IF (CREATE_STATUS .AND. 1) .EQ. 0 THEN GOTO NETWORK_ERROR
$ OPEN/APPEND/ERROR=NETWORK_ERROR BODY 'BODYFILE'
$ DQ = """"
$ JSON = "{" + DQ + "title" + DQ
$ JSON = JSON + ":" + DQ + TITLE + DQ
$ JSON = JSON + "," + DQ + "head" + DQ
$ JSON = JSON + ":" + DQ + HEAD + DQ
$ JSON = JSON + "," + DQ + "base" + DQ
$ JSON = JSON + ":" + DQ + BASE + DQ
$ JSON = JSON + "," + DQ + "body" + DQ
$ JSON = JSON + ":" + DQ + "Closes #" + ISSUE
$ JSON = JSON + DQ + "}"
$ WRITE BODY JSON
$ CLOSE BODY
$ BODY_STATUS = $STATUS
$ IF (BODY_STATUS .AND. 1) .EQ. 0 THEN GOTO NETWORK_ERROR
$ SET FILE/PROTECTION=(S:RWED,O:RWED,G,W) 'BODYFILE'
$
$ GOSUB MAKE_HEADERS
$ URL = "https:" + "//api.github.com/repos/" + REPO + "/pulls"
$ curl --silent --show-error --request POST --output 'APIRESP' --header @'HEADERS' --data-binary @'BODYFILE' 'URL'
$ CURL_STATUS = $STATUS
$ IF (CURL_STATUS .AND. 1) .EQ. 0 THEN GOTO CURL_ERROR
$ SEARCH/NOHEADING/OUTPUT=NL: 'APIRESP' """html_url"""
$ API_SEVERITY = $SEVERITY
$ IF API_SEVERITY .NE. 1 THEN GOTO CREATE_API_ERROR
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub PR create request succeeded."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000001
$
$DO_ISSUES_LIST:
$ ISSUE_STATE = F$EDIT(F$ELEMENT(1," ",ARGUMENTS),"TRIM,UPCASE")
$ ISSUE_EXTRA = F$ELEMENT(2," ",ARGUMENTS)
$ IF ISSUE_STATE .EQS. "" THEN ISSUE_STATE = "OPEN"
$ IF ISSUE_EXTRA .NES. " " THEN GOTO ISSUES_LIST_USAGE
$ IF ISSUE_STATE .EQS. "OPEN" THEN GOTO ISSUE_STATE_OPEN
$ IF ISSUE_STATE .EQS. "CLOSED" THEN GOTO ISSUE_STATE_CLOSED
$ IF ISSUE_STATE .EQS. "ALL" THEN GOTO ISSUE_STATE_ALL
$ GOTO ISSUES_LIST_USAGE
$
$ISSUE_STATE_OPEN:
$ ISSUE_QUERY = "open"
$ GOTO ISSUE_STATE_OK
$
$ISSUE_STATE_CLOSED:
$ ISSUE_QUERY = "closed"
$ GOTO ISSUE_STATE_OK
$
$ISSUE_STATE_ALL:
$ ISSUE_QUERY = "all"
$
$ISSUE_STATE_OK:
$ GOSUB MAKE_HEADERS
$ URL = "https:" + "//api.github.com/repos/" + REPO + "/issues?state=" + ISSUE_QUERY + "&per_page=5"
$ curl --silent --show-error --fail --output 'APIRESP' --header @'HEADERS' 'URL'
$ CURL_STATUS = $STATUS
$ IF (CURL_STATUS .AND. 1) .EQ. 0 THEN GOTO CURL_ERROR
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub issue list request succeeded."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000001
$
$DO_ISSUES_CREATE:
$ ISSUE_TITLE = F$ELEMENT(1," ",ARGUMENTS)
$ ISSUE_EXTRA = F$ELEMENT(2," ",ARGUMENTS)
$ IF ISSUE_TITLE .EQS. " " THEN GOTO ISSUES_CREATE_USAGE
$ IF ISSUE_TITLE .EQS. "" THEN GOTO ISSUES_CREATE_USAGE
$ IF ISSUE_EXTRA .NES. " " THEN GOTO ISSUES_CREATE_USAGE
$
$ CREATE/FDL="RECORD;FORMAT STREAM_LF" 'BODYFILE'
$ CREATE_STATUS = $STATUS
$ IF (CREATE_STATUS .AND. 1) .EQ. 0 THEN GOTO NETWORK_ERROR
$ OPEN/APPEND/ERROR=NETWORK_ERROR BODY 'BODYFILE'
$ DQ = """"
$ JSON = "{" + DQ + "title" + DQ
$ JSON = JSON + ":" + DQ + ISSUE_TITLE + DQ
$ JSON = JSON + "," + DQ + "body" + DQ
$ JSON = JSON + ":" + DQ
$ JSON = JSON + "Created by OVMS Agent GitHub service bridge."
$ JSON = JSON + DQ + "}"
$ WRITE BODY JSON
$ CLOSE BODY
$ BODY_STATUS = $STATUS
$ IF (BODY_STATUS .AND. 1) .EQ. 0 THEN GOTO NETWORK_ERROR
$ SET FILE/PROTECTION=(S:RWED,O:RWED,G,W) 'BODYFILE'
$
$ GOSUB MAKE_HEADERS
$ URL = "https:" + "//api.github.com/repos/" + REPO + "/issues"
$ curl --silent --show-error --request POST --output 'APIRESP' --header @'HEADERS' --data-binary @'BODYFILE' 'URL'
$ CURL_STATUS = $STATUS
$ IF (CURL_STATUS .AND. 1) .EQ. 0 THEN GOTO CURL_ERROR
$ SEARCH/NOHEADING/OUTPUT=NL: 'APIRESP' """html_url"""
$ API_SEVERITY = $SEVERITY
$ IF API_SEVERITY .NE. 1 THEN GOTO CREATE_API_ERROR
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub issue create request succeeded."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000001
$
$CREATE_API_ERROR:
$ WRITE SYS$OUTPUT "GitHub API error response:"
$ TYPE 'APIRESP'
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$MAKE_HEADERS:
$ IF F$SEARCH(HEADERS+";*") .NES. "" THEN DELETE/NOLOG 'HEADERS';*
$ OPEN/WRITE/ERROR=NETWORK_ERROR HDR 'HEADERS'
$ WRITE HDR "Authorization: Bearer ''TOKEN'"
$ WRITE HDR "Accept: application/vnd.github+json"
$ WRITE HDR "X-GitHub-Api-Version: 2022-11-28"
$ WRITE HDR "Content-Type: application/json"
$ CLOSE HDR
$ HEADER_STATUS = $STATUS
$ IF (HEADER_STATUS .AND. 1) .EQ. 0 THEN GOTO NETWORK_ERROR
$ SET FILE/PROTECTION=(S:RWED,O:RWED,G,W) 'HEADERS'
$ PROTECT_STATUS = $STATUS
$ IF (PROTECT_STATUS .AND. 1) .EQ. 0 THEN GOTO NETWORK_ERROR
$ RETURN
$
$PR_CREATE_USAGE:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "Usage: pr create BASE HEAD ISSUE TITLE"
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$ISSUES_LIST_USAGE:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "Usage: issues list [open|closed|all]"
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$ISSUES_CREATE_USAGE:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "Usage: issues create TITLE"
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$CURL_ERROR:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub API request failed."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$NETWORK_ERROR:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub bridge network setup failed."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$PROFILE_ERROR_CLOSE:
$ CLOSE CFG
$
$PROFILE_ERROR:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "GitHub profile is missing or incomplete."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$BAD_REQUEST_CLOSE:
$ CLOSE REQ
$
$BAD_REQUEST:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "Invalid GitHub service bridge request."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$BAD_ACTION:
$ OPEN/WRITE/ERROR=FAIL_NO_RESPONSE RESP 'P2'
$ WRITE RESP "Unsupported GitHub service action."
$ CLOSE RESP
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$FAIL_NO_RESPONSE:
$ GOSUB CLEANUP
$ EXIT %X00000002
$
$CLEANUP:
$ IF F$SEARCH(HEADERS+";*") .NES. "" THEN DELETE/NOLOG 'HEADERS';*
$ IF F$SEARCH(BODYFILE+";*") .NES. "" THEN DELETE/NOLOG 'BODYFILE';*
$ IF F$SEARCH(APIRESP+";*") .NES. "" THEN DELETE/NOLOG 'APIRESP';*
$ TOKEN = ""
$ RETURN
