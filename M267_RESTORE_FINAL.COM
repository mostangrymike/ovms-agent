$ SET NOON
$ BASE = "6c0a1de416ed97e7edf0605685787f7cffd23f36"
$ HEAD = "312ebc45da69bc044d99b8a738f75a2080dc5993"
$ LIST = "M267_RESTORE_FINAL.LIS"
$ IF F$SEARCH(LIST) .NES. "" THEN DELETE/NOLOG 'LIST';*
$ PIPE git diff --name-only 'BASE' 'HEAD' > 'LIST'
$ IF .NOT. $STATUS THEN GOTO DIFF_FAIL
$ OPEN/READ INPUT 'LIST'
$ BATCH = ""
$ COUNT = 0
$LOOP:
$ READ/END=DONE INPUT PATH
$ IF PATH .EQS. "" THEN GOTO LOOP
$ IF PATH .EQS. "OVMS_AGENT_SYMBOLS.DAT" THEN GOTO LOOP
$ ADD = F$LENGTH(PATH)
$ IF BATCH .NES. "" THEN ADD = ADD + 1
$ IF (COUNT .GE. 6) .OR. (F$LENGTH(BATCH) + ADD .GT. 180)
$ THEN
$     @GIT_RESTORE "''BATCH'"
$     IF .NOT. $STATUS THEN GOTO RESTORE_FAIL
$     BATCH = ""
$     COUNT = 0
$ ENDIF
$ IF BATCH .EQS. ""
$ THEN
$     BATCH = PATH
$ ELSE
$     BATCH = BATCH + "," + PATH
$ ENDIF
$ COUNT = COUNT + 1
$ GOTO LOOP
$DONE:
$ CLOSE INPUT
$ IF BATCH .EQS. "" THEN GOTO CLEANUP
$ @GIT_RESTORE "''BATCH'"
$ IF .NOT. $STATUS THEN GOTO RESTORE_FAIL_CLOSED
$CLEANUP:
$ IF F$SEARCH(LIST) .NES. "" THEN DELETE/NOLOG 'LIST';*
$ WRITE SYS$OUTPUT "M267 final changed-file restore completed."
$ EXIT %X00000001
$RESTORE_FAIL:
$ CLOSE INPUT
$RESTORE_FAIL_CLOSED:
$ IF F$SEARCH(LIST) .NES. "" THEN DELETE/NOLOG 'LIST';*
$ WRITE SYS$OUTPUT "%M267-E-RESTORE, final changed-file restore failed"
$ EXIT %X10000002
$DIFF_FAIL:
$ WRITE SYS$OUTPUT "%M267-E-DIFF, unable to enumerate final changed-file set"
$ EXIT %X10000002
