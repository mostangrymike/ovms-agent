$!===========================================================
$! BUILD_M307_REPAIR.COM - M307 repair portability regression
$!===========================================================
$ SET NOON
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$ FINAL_STATUS = 1
$
$ IF F$SEARCH("[]BUILD.DIR;*") .EQS. ""
$ THEN
$     CREATE/DIRECTORY [.BUILD]
$     IF .NOT. $STATUS THEN GOTO FAILED
$ ENDIF
$
$ CC/OBJECT=[.BUILD]M307_LLM_REPAIR.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]LLM_REPAIR.C
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ CC/OBJECT=[.BUILD]M307_REPAIR_TEST.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]M307_REPAIR_TEST.C
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ LINK/EXECUTABLE=[.BUILD]M307_REPAIR_TEST.EXE -
[.BUILD]M307_REPAIR_TEST.OBJ, -
[.BUILD]M307_LLM_REPAIR.OBJ
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ RUN [.BUILD]M307_REPAIR_TEST
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 1
$
$ FAILED:
$ FINAL_STATUS = $STATUS
$ WRITE SYS$ERROR "M307 repair portability/serialization regression failed."
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 'FINAL_STATUS'
