$!===========================================================
$! TEST_M266_PLAN_SCOPE.COM
$! Focused GAP-009 saved plan file-scope regression.
$! Run after a successful @BUILD.
$!===========================================================
$ SET NOON
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$ FINAL_STATUS = 1
$
$ IF F$SEARCH("[.BUILD]OVMS_AGENT.EXE;*") .EQS. ""
$ THEN
$     WRITE SYS$ERROR "Run @BUILD successfully before @TEST_M266_PLAN_SCOPE."
$     FINAL_STATUS = %X10000002
$     GOTO FINISH
$ ENDIF
$
$ CC/OBJECT=[.BUILD]M266_PLAN_SCOPE_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]M266_PLAN_SCOPE_TEST.C
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ LINK/EXECUTABLE=[.BUILD]M266_PLAN_SCOPE_TEST.EXE -
[.BUILD]M266_PLAN_SCOPE_TEST.OBJ, -
[.BUILD]AGENT.OBJ, -
[.BUILD]COMMAND_MODULES.OPT/OPTIONS, -
[.BUILD]PROJECT.OBJ, -
[.BUILD]OPENAI_MODULES.OPT/OPTIONS, -
[.BUILD]EDIT.OBJ, -
[.BUILD]UTIL.OBJ
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ IF F$SEARCH("[.BUILD]GAP009_TEST.DIR;*") .EQS. "" THEN -
    CREATE/DIRECTORY [.BUILD.GAP009_TEST]
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ SET DEFAULT [.BUILD.GAP009_TEST]
$ RUN [-]M266_PLAN_SCOPE_TEST
$ IF .NOT. $STATUS THEN GOTO FAIL
$ GOTO FINISH
$
$ FAIL:
$ FINAL_STATUS = $STATUS
$ WRITE SYS$ERROR "M266 GAP-009 focused regression failed."
$
$ FINISH:
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 'FINAL_STATUS'
