$!===========================================================
$! BUILD_M305_PATCH.COM - M305 direct PATCH RMS regression
$!===========================================================
$ SET NOON
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$ FINAL_STATUS = 1
$
$ IF F$SEARCH("[]BUILD.DIR;*") .EQS. ""
$ THEN
$     CREATE/DIRECTORY [.BUILD]
$     IF .NOT. $STATUS THEN GOTO FAILED
$ ENDIF
$
$ CC/OBJECT=[.BUILD]M305_PROJECT.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]PROJECT.C
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ CC/OBJECT=[.BUILD]M305_RMS_WRITE.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]RMS_WRITE.C
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ CC/OBJECT=[.BUILD]M305_DIRECT_PATCH_TEST.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]M305_DIRECT_PATCH_TEST.C
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ LINK/EXECUTABLE=[.BUILD]M305_DIRECT_PATCH_TEST.EXE -
[.BUILD]M305_DIRECT_PATCH_TEST.OBJ, -
[.BUILD]M305_PROJECT.OBJ, -
[.BUILD]M305_RMS_WRITE.OBJ
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ RUN [.BUILD]M305_DIRECT_PATCH_TEST
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 1
$
$ FAILED:
$ FINAL_STATUS = $STATUS
$ WRITE SYS$ERROR "M305 direct PATCH RMS regression failed."
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 'FINAL_STATUS'
