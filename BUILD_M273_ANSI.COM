$!===========================================================
$! BUILD_M273_ANSI.COM - M273 presentation/stream regressions
$!===========================================================
$ SET NOON
$ FINAL_STATUS = 1
$
$ CC/OBJECT=[.BUILD]ANSI_TERM.OBJ -
     /STANDARD=RELAXED_ANSI89 -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     /INCLUDE_DIRECTORY=([.SRC]) -
     [.SRC]ANSI_TERM.C
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ CC/OBJECT=[.BUILD]M273_ANSI_TERM_TEST.OBJ -
     /STANDARD=RELAXED_ANSI89 -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     /INCLUDE_DIRECTORY=([.SRC]) -
     [.SRC]M273_ANSI_TERM_TEST.C
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ LINK/EXECUTABLE=[.BUILD]M273_ANSI_TERM_TEST.EXE -
     [.BUILD]M273_ANSI_TERM_TEST.OBJ, -
     [.BUILD]ANSI_TERM.OBJ
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ M273_TEST_EXE = F$SEARCH("[.BUILD]M273_ANSI_TERM_TEST.EXE")
$ IF M273_TEST_EXE .EQS. ""
$ THEN
$     FINAL_STATUS = 2
$     GOTO FAIL_DONE
$ ENDIF
$ M273TEST :== $'M273_TEST_EXE'
$
$ IF F$SEARCH("[.BUILD]M273_REDIRECT.TXT;*") .NES. "" -
     THEN DELETE/NOLOG [.BUILD]M273_REDIRECT.TXT;*
$ DEFINE/USER SYS$OUTPUT [.BUILD]M273_REDIRECT.TXT
$ M273TEST REDIRECT
$ IF .NOT. $STATUS THEN GOTO FAIL
$ M273TEST VERIFY [.BUILD]M273_REDIRECT.TXT
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ IF F$SEARCH("[.BUILD]M273_OVERRIDE.TXT;*") .NES. "" -
     THEN DELETE/NOLOG [.BUILD]M273_OVERRIDE.TXT;*
$ DEFINE/USER OVMS_AGENT_PLAIN "1"
$ DEFINE/USER SYS$OUTPUT [.BUILD]M273_OVERRIDE.TXT
$ M273TEST OVERRIDE
$ IF .NOT. $STATUS THEN GOTO FAIL
$ M273TEST VERIFY [.BUILD]M273_OVERRIDE.TXT
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ @BUILD_M273_STREAM
$ IF .NOT. $STATUS THEN GOTO FAIL
$
$ WRITE SYS$OUTPUT "M273 presentation/stream regressions passed."
$ EXIT 1
$
$ FAIL:
$ FINAL_STATUS = $STATUS
$ FAIL_DONE:
$ WRITE SYS$ERROR "M273 presentation/stream regression failed."
$ EXIT 'FINAL_STATUS'
