$! BUILD_COMMAND_MODULES.COM
$ SET NOON
$ CC/OBJECT=[.BUILD]COMMAND.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]COMMAND.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]COMMAND_CORE.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]COMMAND_CORE.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]COMMAND_DCL.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]COMMAND_DCL.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]COMMAND_REGISTRY.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]COMMAND_REGISTRY.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]COMMAND_PROJECT.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]COMMAND_PROJECT_M273.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]COMMAND_AGENT.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]COMMAND_AGENT_M259.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]COMMAND_PROVIDER.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]COMMAND_PROVIDER.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]COMMAND_GITHUB.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]COMMAND_GITHUB.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]LLM_CONFIG.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_CONFIG.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]GH_CONFIG.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]GH_CONFIG.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]GH_AUTH.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]GH_AUTH_M262.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]GITHUB_M262.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]GITHUB_M262.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]SECRET_INPUT.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]SECRET_INPUT.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]SYMBOL_INDEX.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]SYMBOL_INDEX.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]COMMAND_SYMBOL.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]COMMAND_SYMBOL.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ CC/OBJECT=[.BUILD]MOVE_TEST.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]MOVE_TEST.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$
$! M268 compiles the standalone AUTOPILOT controller here after the mature
$! LLM modules have been built.  It is linked through LLM_MODULES.OPT, not
$! COMMAND_MODULES.OPT, so focused command/retry link surfaces stay unchanged.
$ CC/OBJECT=[.BUILD]LLM_AUTOPILOT.OBJ -
     /STANDARD=RELAXED_ANSI89 -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_AUTOPILOT.C
$ IF .NOT. $STATUS THEN EXIT $STATUS
$ EXIT 1
