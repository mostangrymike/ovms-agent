$!===========================================================
$! BUILD_M253.COM - M253 parity evidence regressions
$!===========================================================
$ SET NOON
$
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$ FINAL_STATUS = 1
$
$ WRITE SYS$OUTPUT "Running M253 parity evidence regressions..."
$
$ CC/OBJECT=[.BUILD]M253_FILE_EVIDENCE_TEST.OBJ -
 /STANDARD=RELAXED_ANSI89 -
 /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
 /INCLUDE_DIRECTORY=([.SRC]) -
 [.SRC]M253_FILE_EVIDENCE_TEST.C
$ IF .NOT. $STATUS THEN GOTO FAILURE
$
$ LINK/EXECUTABLE=[.BUILD]M253_FILE_EVIDENCE_TEST.EXE -
 [.BUILD]M253_FILE_EVIDENCE_TEST.OBJ, -
 [.BUILD]EDIT_TXN.OBJ, -
 [.BUILD]RMS_WRITE.OBJ
$ IF .NOT. $STATUS THEN GOTO FAILURE
$
$ RUN [.BUILD]M253_FILE_EVIDENCE_TEST
$ IF .NOT. $STATUS THEN GOTO FAILURE
$
$ WRITE SYS$OUTPUT "All M253 parity evidence regressions passed."
$ GOTO FINISH
$
$ FAILURE:
$ FINAL_STATUS = $STATUS
$ WRITE SYS$OUTPUT "M253 parity evidence regression failed."
$
$ FINISH:
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 'FINAL_STATUS'
