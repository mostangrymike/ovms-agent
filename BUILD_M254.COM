$! BUILD_M254.COM - Phase 3 execution-mode evidence
$ SET NOON
$
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
                F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$
$ FINAL_STATUS = 1
$ TEST_OUT = "M254_HEADLESS.OUT"
$ SAVED_POLICY = F$TRNLNM("OVMS_AGENT_APPROVAL_POLICY","LNM$PROCESS")
$ SAVED_WRITE = F$TRNLNM("OVMS_AGENT_WRITE_ENABLED","LNM$PROCESS")
$ SAVED_DCL = F$TRNLNM("OVMS_AGENT_DCL_ENABLED","LNM$PROCESS")
$
$ WRITE SYS$OUTPUT "Running M254 execution-mode regressions..."
$ GOSUB CLEAN_OUTPUT
$
$! Workspace policy must not authorize approved DCL.
$ DEFINE/PROCESS/NOLOG OVMS_AGENT_APPROVAL_POLICY "workspace"
$ DEFINE/PROCESS/NOLOG OVMS_AGENT_WRITE_ENABLED "YES"
$ DEFINE/PROCESS/NOLOG OVMS_AGENT_DCL_ENABLED "YES"
$ DEFINE/USER/NOLOG SYS$OUTPUT 'TEST_OUT'
$ @OVMS_AGENT "DCL SHOW DEFAULT" JSON
$ DENY_STATUS = $STATUS
$
$ IF DENY_STATUS .NE. %X10000002
$ THEN
$     WRITE SYS$OUTPUT "M254 headless policy denial returned unexpected status."
$     FINAL_STATUS = %X10000002
$     GOTO FINISH
$ ENDIF
$
$ SEARCH/NOOUTPUT 'TEST_OUT' """executed"":false"
$ IF .NOT. $STATUS
$ THEN
$     WRITE SYS$OUTPUT "M254 headless policy denial JSON evidence missing."
$     FINAL_STATUS = %X10000002
$     GOTO FINISH
$ ENDIF
$
$ GOSUB CLEAN_OUTPUT
$
$! Full policy plus both gates executes a harmless DCL command.
$ DEFINE/PROCESS/NOLOG OVMS_AGENT_APPROVAL_POLICY "full"
$ DEFINE/PROCESS/NOLOG OVMS_AGENT_WRITE_ENABLED "YES"
$ DEFINE/PROCESS/NOLOG OVMS_AGENT_DCL_ENABLED "YES"
$ DEFINE/USER/NOLOG SYS$OUTPUT 'TEST_OUT'
$ @OVMS_AGENT "DCL SHOW DEFAULT" JSON
$ RUN_STATUS = $STATUS
$
$ IF .NOT. RUN_STATUS
$ THEN
$     WRITE SYS$OUTPUT "M254 headless approved DCL returned failure."
$     FINAL_STATUS = RUN_STATUS
$     GOTO FINISH
$ ENDIF
$
$ SEARCH/NOOUTPUT 'TEST_OUT' """executed"":true"
$ IF .NOT. $STATUS THEN GOTO JSON_FAIL
$ SEARCH/NOOUTPUT 'TEST_OUT' """condition"":""%X00000001"""
$ IF .NOT. $STATUS THEN GOTO JSON_FAIL
$ SEARCH/NOOUTPUT 'TEST_OUT' """success"":true"
$ IF .NOT. $STATUS THEN GOTO JSON_FAIL
$
$ WRITE SYS$OUTPUT "M254 headless DCL policy/status evidence passed."
$ GOTO FINISH
$
$JSON_FAIL:
$ WRITE SYS$OUTPUT "M254 headless success JSON evidence missing."
$ FINAL_STATUS = %X10000002
$
$FINISH:
$ GOSUB CLEAN_OUTPUT
$
$ DEASSIGN/PROCESS/NOLOG OVMS_AGENT_APPROVAL_POLICY
$ IF SAVED_POLICY .NES. "" THEN DEFINE/PROCESS/NOLOG OVMS_AGENT_APPROVAL_POLICY 'SAVED_POLICY'
$ DEASSIGN/PROCESS/NOLOG OVMS_AGENT_WRITE_ENABLED
$ IF SAVED_WRITE .NES. "" THEN DEFINE/PROCESS/NOLOG OVMS_AGENT_WRITE_ENABLED 'SAVED_WRITE'
$ DEASSIGN/PROCESS/NOLOG OVMS_AGENT_DCL_ENABLED
$ IF SAVED_DCL .NES. "" THEN DEFINE/PROCESS/NOLOG OVMS_AGENT_DCL_ENABLED 'SAVED_DCL'
$
$ SET DEFAULT 'SAVED_DEFAULT'
$ IF FINAL_STATUS THEN WRITE SYS$OUTPUT "All M254 execution-mode regressions passed."
$ EXIT 'FINAL_STATUS'
$
$CLEAN_OUTPUT:
$ DELETE/NOLOG/NOCONFIRM 'TEST_OUT';* 2>NLA0:
$ RETURN
