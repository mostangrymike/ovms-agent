$!=====================================================================
$! APPLY_V2.COM
$! Create OVMS Agent Version 2 modular source tree
$!=====================================================================
$ SET NOON
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
                F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$
$ WRITE SYS$OUTPUT "Creating OVMS Agent Version 2 source files..."
$
$ IF F$SEARCH("[.SRC]000000.DIR") .EQS. ""
$ THEN
$     CREATE/DIRECTORY [.SRC]
$ ENDIF
$
$!---------------------------------------------------------------------
$! AGENT.H
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]AGENT.H
$ WRITE OUT "#ifndef OVMS_AGENT_AGENT_H"
$ WRITE OUT "#define OVMS_AGENT_AGENT_H"
$ WRITE OUT ""
$ WRITE OUT "#define OVMS_AGENT_VERSION ""0.2.0"""
$ WRITE OUT "#define OVMS_AGENT_INPUT_SIZE 1024"
$ WRITE OUT ""
$ WRITE OUT "typedef struct agent_state {"
$ WRITE OUT "    int running;"
$ WRITE OUT "    const char *project_root;"
$ WRITE OUT "    int api_key_defined;"
$ WRITE OUT "    int write_enabled;"
$ WRITE OUT "    int dcl_enabled;"
$ WRITE OUT "} agent_state;"
$ WRITE OUT ""
$ WRITE OUT "int agent_initialize(agent_state *state);"
$ WRITE OUT "void agent_shutdown(agent_state *state);"
$ WRITE OUT "int agent_is_running(const agent_state *state);"
$ WRITE OUT "void agent_stop(agent_state *state);"
$ WRITE OUT ""
$ WRITE OUT "#endif"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! AGENT.C
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]AGENT.C
$ WRITE OUT "#include <stdio.h>"
$ WRITE OUT "#include <stdlib.h>"
$ WRITE OUT ""
$ WRITE OUT "#include ""agent.h"""
$ WRITE OUT ""
$ WRITE OUT "int agent_initialize(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    const char *api_key;"
$ WRITE OUT ""
$ WRITE OUT "    if (state == NULL) {"
$ WRITE OUT "        return 0;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    state->running = 1;"
$ WRITE OUT "    state->project_root = getenv(""OVMS_AGENT_ROOT"");"
$ WRITE OUT "    api_key = getenv(""OPENAI_API_KEY"");"
$ WRITE OUT "    state->api_key_defined ="
$ WRITE OUT "        api_key != NULL && *api_key != '\0';"
$ WRITE OUT "    state->write_enabled = 0;"
$ WRITE OUT "    state->dcl_enabled = 0;"
$ WRITE OUT ""
$ WRITE OUT "    (void)puts(""OVMS Agent"");"
$ WRITE OUT "    (void)puts(""Native agentic programming assistant for OpenVMS"");"
$ WRITE OUT "    (void)printf(""Version %s\n\n"", OVMS_AGENT_VERSION);"
$ WRITE OUT ""
$ WRITE OUT "    return 1;"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void agent_shutdown(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    if (state != NULL) {"
$ WRITE OUT "        state->running = 0;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    (void)puts(""OVMS Agent terminated."");"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "int agent_is_running(const agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    return state != NULL && state->running;"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void agent_stop(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    if (state != NULL) {"
$ WRITE OUT "        state->running = 0;"
$ WRITE OUT "    }"
$ WRITE OUT "}"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! UTIL.H
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]UTIL.H
$ WRITE OUT "#ifndef OVMS_AGENT_UTIL_H"
$ WRITE OUT "#define OVMS_AGENT_UTIL_H"
$ WRITE OUT ""
$ WRITE OUT "void util_trim(char *text);"
$ WRITE OUT "void util_uppercase(char *text);"
$ WRITE OUT "char *util_skip_space(char *text);"
$ WRITE OUT ""
$ WRITE OUT "#endif"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! UTIL.C
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]UTIL.C
$ WRITE OUT "#include <ctype.h>"
$ WRITE OUT "#include <stddef.h>"
$ WRITE OUT "#include <string.h>"
$ WRITE OUT ""
$ WRITE OUT "#include ""util.h"""
$ WRITE OUT ""
$ WRITE OUT "void util_trim(char *text)"
$ WRITE OUT "{"
$ WRITE OUT "    size_t length;"
$ WRITE OUT ""
$ WRITE OUT "    if (text == NULL) {"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    length = strlen(text);"
$ WRITE OUT ""
$ WRITE OUT "    while (length != 0U) {"
$ WRITE OUT "        unsigned char ch;"
$ WRITE OUT ""
$ WRITE OUT "        ch = (unsigned char)text[length - 1U];"
$ WRITE OUT ""
$ WRITE OUT "        if (ch != '\n' && ch != '\r' && !isspace(ch)) {"
$ WRITE OUT "            break;"
$ WRITE OUT "        }"
$ WRITE OUT ""
$ WRITE OUT "        --length;"
$ WRITE OUT "        text[length] = '\0';"
$ WRITE OUT "    }"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void util_uppercase(char *text)"
$ WRITE OUT "{"
$ WRITE OUT "    unsigned char *position;"
$ WRITE OUT ""
$ WRITE OUT "    if (text == NULL) {"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    position = (unsigned char *)text;"
$ WRITE OUT ""
$ WRITE OUT "    while (*position != (unsigned char)'\0') {"
$ WRITE OUT "        *position = (unsigned char)toupper((int)*position);"
$ WRITE OUT "        ++position;"
$ WRITE OUT "    }"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "char *util_skip_space(char *text)"
$ WRITE OUT "{"
$ WRITE OUT "    if (text == NULL) {"
$ WRITE OUT "        return NULL;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    while (*text != '\0' && isspace((unsigned char)*text)) {"
$ WRITE OUT "        ++text;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    return text;"
$ WRITE OUT "}"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! PROJECT.H
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]PROJECT.H
$ WRITE OUT "#ifndef OVMS_AGENT_PROJECT_H"
$ WRITE OUT "#define OVMS_AGENT_PROJECT_H"
$ WRITE OUT ""
$ WRITE OUT "#include ""agent.h"""
$ WRITE OUT ""
$ WRITE OUT "void project_show_root(const agent_state *state);"
$ WRITE OUT "void project_show_status(const agent_state *state);"
$ WRITE OUT "void project_list(const agent_state *state);"
$ WRITE OUT ""
$ WRITE OUT "#endif"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! PROJECT.C
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]PROJECT.C
$ WRITE OUT "#include <dirent.h>"
$ WRITE OUT "#include <errno.h>"
$ WRITE OUT "#include <stdio.h>"
$ WRITE OUT "#include <string.h>"
$ WRITE OUT ""
$ WRITE OUT "#include ""project.h"""
$ WRITE OUT ""
$ WRITE OUT "void project_show_root(const agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    if (state == NULL ||"
$ WRITE OUT "        state->project_root == NULL ||"
$ WRITE OUT "        *state->project_root == '\0') {"
$ WRITE OUT "        (void)puts(""OVMS_AGENT_ROOT is not defined."");"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    (void)printf(""Project root: %s\n"", state->project_root);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void project_show_status(const agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    if (state == NULL) {"
$ WRITE OUT "        (void)puts(""Agent state is unavailable."");"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    (void)printf(""Version:       %s\n"", OVMS_AGENT_VERSION);"
$ WRITE OUT "    (void)printf(""Project root:  %s\n"","
$ WRITE OUT "        state->project_root != NULL &&"
$ WRITE OUT "        *state->project_root != '\0'"
$ WRITE OUT "            ? state->project_root"
$ WRITE OUT "            : ""not defined"");"
$ WRITE OUT "    (void)printf(""API key:       %s\n"","
$ WRITE OUT "        state->api_key_defined ? ""defined"" : ""not defined"");"
$ WRITE OUT "    (void)printf(""Write access:  %s\n"","
$ WRITE OUT "        state->write_enabled ? ""enabled"" : ""disabled"");"
$ WRITE OUT "    (void)printf(""DCL execution: %s\n"","
$ WRITE OUT "        state->dcl_enabled ? ""enabled"" : ""disabled"");"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void project_list(const agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    DIR *directory;"
$ WRITE OUT "    struct dirent *entry;"
$ WRITE OUT ""
$ WRITE OUT "    if (state == NULL ||"
$ WRITE OUT "        state->project_root == NULL ||"
$ WRITE OUT "        *state->project_root == '\0') {"
$ WRITE OUT "        (void)puts(""OVMS_AGENT_ROOT is not defined."");"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    directory = opendir(state->project_root);"
$ WRITE OUT ""
$ WRITE OUT "    if (directory == NULL) {"
$ WRITE OUT "        (void)printf(""Unable to open project root: %s\n"","
$ WRITE OUT "                     state->project_root);"
$ WRITE OUT "        (void)printf(""Reason: %s\n"", strerror(errno));"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    (void)printf(""Directory: %s\n\n"", state->project_root);"
$ WRITE OUT ""
$ WRITE OUT "    while ((entry = readdir(directory)) != NULL) {"
$ WRITE OUT "        if (strcmp(entry->d_name, ""."") != 0 &&"
$ WRITE OUT "            strcmp(entry->d_name, "".."") != 0) {"
$ WRITE OUT "            (void)printf(""%s\n"", entry->d_name);"
$ WRITE OUT "        }"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (closedir(directory) != 0) {"
$ WRITE OUT "        (void)printf(""Warning: unable to close directory: %s\n"","
$ WRITE OUT "                     strerror(errno));"
$ WRITE OUT "    }"
$ WRITE OUT "}"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! COMMAND.H
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]COMMAND.H
$ WRITE OUT "#ifndef OVMS_AGENT_COMMAND_H"
$ WRITE OUT "#define OVMS_AGENT_COMMAND_H"
$ WRITE OUT ""
$ WRITE OUT "#include ""agent.h"""
$ WRITE OUT ""
$ WRITE OUT "void command_prompt(void);"
$ WRITE OUT "void command_execute(agent_state *state, char *input);"
$ WRITE OUT ""
$ WRITE OUT "#endif"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! COMMAND.C
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]COMMAND.C
$ WRITE OUT "#include <stdio.h>"
$ WRITE OUT "#include <string.h>"
$ WRITE OUT ""
$ WRITE OUT "#include ""command.h"""
$ WRITE OUT "#include ""project.h"""
$ WRITE OUT "#include ""util.h"""
$ WRITE OUT ""
$ WRITE OUT "typedef void (*command_handler)(agent_state *state);"
$ WRITE OUT ""
$ WRITE OUT "typedef struct command_entry {"
$ WRITE OUT "    const char *name;"
$ WRITE OUT "    const char *description;"
$ WRITE OUT "    command_handler handler;"
$ WRITE OUT "} command_entry;"
$ WRITE OUT ""
$ WRITE OUT "static void command_help(agent_state *state);"
$ WRITE OUT "static void command_version(agent_state *state);"
$ WRITE OUT "static void command_root(agent_state *state);"
$ WRITE OUT "static void command_status(agent_state *state);"
$ WRITE OUT "static void command_list(agent_state *state);"
$ WRITE OUT "static void command_quit(agent_state *state);"
$ WRITE OUT ""
$ WRITE OUT "static const command_entry command_table[] = {"
$ WRITE OUT "    { ""HELP"",    ""Display command help"", command_help },"
$ WRITE OUT "    { ""VERSION"", ""Display agent version"", command_version },"
$ WRITE OUT "    { ""ROOT"",    ""Display the project root"", command_root },"
$ WRITE OUT "    { ""STATUS"",  ""Display agent status"", command_status },"
$ WRITE OUT "    { ""LIST"",    ""List the project root"", command_list },"
$ WRITE OUT "    { ""QUIT"",    ""Exit OVMS Agent"", command_quit },"
$ WRITE OUT "    { ""EXIT"",    ""Exit OVMS Agent"", command_quit },"
$ WRITE OUT "    { NULL, NULL, NULL }"
$ WRITE OUT "};"
$ WRITE OUT ""
$ WRITE OUT "void command_prompt(void)"
$ WRITE OUT "{"
$ WRITE OUT "    (void)fputs(""OVMS-AGENT> "", stdout);"
$ WRITE OUT "    (void)fflush(stdout);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void command_execute(agent_state *state, char *input)"
$ WRITE OUT "{"
$ WRITE OUT "    const command_entry *entry;"
$ WRITE OUT "    char *command;"
$ WRITE OUT ""
$ WRITE OUT "    if (state == NULL || input == NULL) {"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    util_trim(input);"
$ WRITE OUT "    command = util_skip_space(input);"
$ WRITE OUT "    util_uppercase(command);"
$ WRITE OUT ""
$ WRITE OUT "    if (command == NULL || *command == '\0') {"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    for (entry = command_table; entry->name != NULL; ++entry) {"
$ WRITE OUT "        if (strcmp(command, entry->name) == 0) {"
$ WRITE OUT "            entry->handler(state);"
$ WRITE OUT "            return;"
$ WRITE OUT "        }"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    (void)printf(""Unknown command: %s\n"", command);"
$ WRITE OUT "    (void)puts(""Enter HELP for available commands."");"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_help(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    const command_entry *entry;"
$ WRITE OUT ""
$ WRITE OUT "    (void)state;"
$ WRITE OUT "    (void)puts(""Commands:"");"
$ WRITE OUT ""
$ WRITE OUT "    for (entry = command_table; entry->name != NULL; ++entry) {"
$ WRITE OUT "        if (strcmp(entry->name, ""EXIT"") != 0) {"
$ WRITE OUT "            (void)printf(""  %-10s %s\n"","
$ WRITE OUT "                         entry->name,"
$ WRITE OUT "                         entry->description);"
$ WRITE OUT "        }"
$ WRITE OUT "    }"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_version(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    (void)state;"
$ WRITE OUT "    (void)printf(""OVMS Agent %s\n"", OVMS_AGENT_VERSION);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_root(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    project_show_root(state);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_status(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    project_show_status(state);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_list(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    project_list(state);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_quit(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    agent_stop(state);"
$ WRITE OUT "}"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! MAIN.C
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]MAIN.C
$ WRITE OUT "#include <stdio.h>"
$ WRITE OUT "#include <stdlib.h>"
$ WRITE OUT ""
$ WRITE OUT "#include ""agent.h"""
$ WRITE OUT "#include ""command.h"""
$ WRITE OUT ""
$ WRITE OUT "int main(void)"
$ WRITE OUT "{"
$ WRITE OUT "    agent_state state;"
$ WRITE OUT "    char input[OVMS_AGENT_INPUT_SIZE];"
$ WRITE OUT ""
$ WRITE OUT "    if (!agent_initialize(&state)) {"
$ WRITE OUT "        (void)fputs(""Unable to initialize OVMS Agent.\n"", stderr);"
$ WRITE OUT "        return EXIT_FAILURE;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    while (agent_is_running(&state)) {"
$ WRITE OUT "        command_prompt();"
$ WRITE OUT ""
$ WRITE OUT "        if (fgets(input, sizeof(input), stdin) == NULL) {"
$ WRITE OUT "            (void)putchar('\n');"
$ WRITE OUT "            break;"
$ WRITE OUT "        }"
$ WRITE OUT ""
$ WRITE OUT "        command_execute(&state, input);"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    agent_shutdown(&state);"
$ WRITE OUT "    return EXIT_SUCCESS;"
$ WRITE OUT "}"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! BUILD.COM
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT BUILD.COM
$ WRITE OUT "$!==========================================================="
$ WRITE OUT "$! BUILD.COM - Build OVMS Agent"
$ WRITE OUT "$!==========================================================="
$ WRITE OUT "$ SET NOON"
$ WRITE OUT "$ SAVED_DEFAULT = F$ENVIRONMENT(""DEFAULT"")"
$ WRITE OUT "$ PROCEDURE = F$ENVIRONMENT(""PROCEDURE"")"
$ WRITE OUT "$ PROJECT_DIR = F$PARSE(PROCEDURE,,,""DEVICE"") + -"
$ WRITE OUT "                F$PARSE(PROCEDURE,,,""DIRECTORY"")"
$ WRITE OUT "$ SET DEFAULT 'PROJECT_DIR'"
$ WRITE OUT "$ FINAL_STATUS = 1"
$ WRITE OUT "$ WRITE SYS$OUTPUT ""Building OVMS Agent Version 2..."""
$ WRITE OUT "$ IF F$SEARCH(""[.BUILD]000000.DIR"") .EQS. """""
$ WRITE OUT "$ THEN"
$ WRITE OUT "$     CREATE/DIRECTORY [.BUILD]"
$ WRITE OUT "$ ENDIF"
$ WRITE OUT "$ CC/OBJECT=[.BUILD]MAIN.OBJ -"
$ WRITE OUT "     /STANDARD=C99 -"
$ WRITE OUT "     /INCLUDE_DIRECTORY=([.SRC]) -"
$ WRITE OUT "     [.SRC]MAIN.C"
$ WRITE OUT "$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR"
$ WRITE OUT "$ CC/OBJECT=[.BUILD]AGENT.OBJ -"
$ WRITE OUT "     /STANDARD=C99 -"
$ WRITE OUT "     /INCLUDE_DIRECTORY=([.SRC]) -"
$ WRITE OUT "     [.SRC]AGENT.C"
$ WRITE OUT "$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR"
$ WRITE OUT "$ CC/OBJECT=[.BUILD]COMMAND.OBJ -"
$ WRITE OUT "     /STANDARD=C99 -"
$ WRITE OUT "     /INCLUDE_DIRECTORY=([.SRC]) -"
$ WRITE OUT "     [.SRC]COMMAND.C"
$ WRITE OUT "$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR"
$ WRITE OUT "$ CC/OBJECT=[.BUILD]PROJECT.OBJ -"
$ WRITE OUT "     /STANDARD=C99 -"
$ WRITE OUT "     /INCLUDE_DIRECTORY=([.SRC]) -"
$ WRITE OUT "     [.SRC]PROJECT.C"
$ WRITE OUT "$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR"
$ WRITE OUT "$ CC/OBJECT=[.BUILD]UTIL.OBJ -"
$ WRITE OUT "     /STANDARD=C99 -"
$ WRITE OUT "     /INCLUDE_DIRECTORY=([.SRC]) -"
$ WRITE OUT "     [.SRC]UTIL.C"
$ WRITE OUT "$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR"
$ WRITE OUT "$ LINK/EXECUTABLE=[.BUILD]OVMS_AGENT.EXE -"
$ WRITE OUT "     [.BUILD]MAIN.OBJ, -"
$ WRITE OUT "     [.BUILD]AGENT.OBJ, -"
$ WRITE OUT "     [.BUILD]COMMAND.OBJ, -"
$ WRITE OUT "     [.BUILD]PROJECT.OBJ, -"
$ WRITE OUT "     [.BUILD]UTIL.OBJ"
$ WRITE OUT "$ IF .NOT. $STATUS"
$ WRITE OUT "$ THEN"
$ WRITE OUT "$     FINAL_STATUS = $STATUS"
$ WRITE OUT "$     WRITE SYS$ERROR ""Link failed."""
$ WRITE OUT "$     GOTO FINISH"
$ WRITE OUT "$ ENDIF"
$ WRITE OUT "$ WRITE SYS$OUTPUT ""Build completed successfully."""
$ WRITE OUT "$ WRITE SYS$OUTPUT ""Run with: $ @OVMS_AGENT"""
$ WRITE OUT "$ GOTO FINISH"
$ WRITE OUT "$ COMPILE_ERROR:"
$ WRITE OUT "$ FINAL_STATUS = $STATUS"
$ WRITE OUT "$ WRITE SYS$ERROR ""Compilation failed."""
$ WRITE OUT "$ FINISH:"
$ WRITE OUT "$ SET DEFAULT 'SAVED_DEFAULT'"
$ WRITE OUT "$ EXIT 'FINAL_STATUS'"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! OVMS_AGENT.COM
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT OVMS_AGENT.COM
$ WRITE OUT "$ SET NOON"
$ WRITE OUT "$ PROCEDURE = F$ENVIRONMENT(""PROCEDURE"")"
$ WRITE OUT "$ PROJECT_DIR = F$PARSE(PROCEDURE,,,""DEVICE"") + -"
$ WRITE OUT "                F$PARSE(PROCEDURE,,,""DIRECTORY"")"
$ WRITE OUT "$ IMAGE = PROJECT_DIR + ""[.BUILD]OVMS_AGENT.EXE"""
$ WRITE OUT "$ IF F$SEARCH(IMAGE) .EQS. """""
$ WRITE OUT "$ THEN"
$ WRITE OUT "$     WRITE SYS$ERROR ""%OVMS-AGENT-E-NOIMAGE, executable not found"""
$ WRITE OUT "$     WRITE SYS$ERROR ""Run @BUILD first."""
$ WRITE OUT "$     EXIT %X10000002"
$ WRITE OUT "$ ENDIF"
$ WRITE OUT "$ RUN 'IMAGE'"
$ WRITE OUT "$ EXIT $STATUS"
$ CLOSE OUT
$
$ WRITE SYS$OUTPUT ""
$ WRITE SYS$OUTPUT "Version 2 files created."
$ WRITE SYS$OUTPUT "Previous OpenVMS file versions remain available."
$ WRITE SYS$OUTPUT ""
$ WRITE SYS$OUTPUT "Next commands:"
$ WRITE SYS$OUTPUT "$ @BUILD"
$ WRITE SYS$OUTPUT "$ DEFINE/PROCESS OVMS_AGENT_ROOT SYS$LOGIN:[OVMS_AGENT]"
$ WRITE SYS$OUTPUT "$ @OVMS_AGENT"
$ WRITE SYS$OUTPUT ""
$
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 1
