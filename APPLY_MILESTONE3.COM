$!=====================================================================
$! APPLY_MILESTONE3.COM
$! Add LIST/ALL and safe READ support to OVMS Agent
$!=====================================================================
$ SET NOON
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$
$ WRITE SYS$OUTPUT "Applying OVMS Agent Milestone 3..."
$
$!---------------------------------------------------------------------
$! AGENT.H
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]AGENT.H
$ WRITE OUT "#ifndef OVMS_AGENT_AGENT_H"
$ WRITE OUT "#define OVMS_AGENT_AGENT_H"
$ WRITE OUT ""
$ WRITE OUT "#define OVMS_AGENT_VERSION ""0.3.0"""
$ WRITE OUT "#define OVMS_AGENT_INPUT_SIZE 1024"
$ WRITE OUT ""
$ WRITE OUT "typedef struct agent_state {"
$ WRITE OUT "    int running;"
$ WRITE OUT "    const char *project_root;"
$ WRITE OUT "    int api_key_defined;"
$ WRITE OUT "    int write_enabled;"
$ WRITE OUT "    int dcl_enabled;"
$ WRITE OUT "} agent_state;"
$ WRITE OUT ""
$ WRITE OUT "int agent_initialize(agent_state *state);"
$ WRITE OUT "void agent_shutdown(agent_state *state);"
$ WRITE OUT "int agent_is_running(const agent_state *state);"
$ WRITE OUT "void agent_stop(agent_state *state);"
$ WRITE OUT ""
$ WRITE OUT "#endif"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! AGENT.C
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]AGENT.C
$ WRITE OUT "#include <stdio.h>"
$ WRITE OUT "#include <stdlib.h>"
$ WRITE OUT "#include <unistd.h>"
$ WRITE OUT ""
$ WRITE OUT "#include ""agent.h"""
$ WRITE OUT ""
$ WRITE OUT "int agent_initialize(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    const char *api_key;"
$ WRITE OUT ""
$ WRITE OUT "    if (state == NULL) {"
$ WRITE OUT "        return 0;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    state->running = 1;"
$ WRITE OUT "    state->project_root = getenv(""OVMS_AGENT_ROOT"");"
$ WRITE OUT "    api_key = getenv(""OPENAI_API_KEY"");"
$ WRITE OUT ""
$ WRITE OUT "    state->api_key_defined ="
$ WRITE OUT "        api_key != NULL && *api_key != '\0';"
$ WRITE OUT "    state->write_enabled = 0;"
$ WRITE OUT "    state->dcl_enabled = 0;"
$ WRITE OUT ""
$ WRITE OUT "    if (state->project_root != NULL &&"
$ WRITE OUT "        *state->project_root != '\0') {"
$ WRITE OUT "        if (chdir(state->project_root) != 0) {"
$ WRITE OUT "            (void)fprintf(stderr,"
$ WRITE OUT "                ""Unable to set project root as current directory.\n"");"
$ WRITE OUT "            return 0;"
$ WRITE OUT "        }"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    (void)puts(""OVMS Agent"");"
$ WRITE OUT "    (void)puts(""Native agentic programming assistant for OpenVMS"");"
$ WRITE OUT "    (void)printf(""Version %s\n\n"", OVMS_AGENT_VERSION);"
$ WRITE OUT ""
$ WRITE OUT "    return 1;"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void agent_shutdown(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    if (state != NULL) {"
$ WRITE OUT "        state->running = 0;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    (void)puts(""OVMS Agent terminated."");"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "int agent_is_running(const agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    return state != NULL && state->running;"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void agent_stop(agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    if (state != NULL) {"
$ WRITE OUT "        state->running = 0;"
$ WRITE OUT "    }"
$ WRITE OUT "}"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! PROJECT.H
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]PROJECT.H
$ WRITE OUT "#ifndef OVMS_AGENT_PROJECT_H"
$ WRITE OUT "#define OVMS_AGENT_PROJECT_H"
$ WRITE OUT ""
$ WRITE OUT "#include ""agent.h"""
$ WRITE OUT ""
$ WRITE OUT "void project_show_root(const agent_state *state);"
$ WRITE OUT "void project_show_status(const agent_state *state);"
$ WRITE OUT "void project_list(const agent_state *state, int show_all);"
$ WRITE OUT "void project_read(const agent_state *state, const char *path);"
$ WRITE OUT ""
$ WRITE OUT "#endif"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! PROJECT.C
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]PROJECT.C
$ WRITE OUT "#include <ctype.h>"
$ WRITE OUT "#include <dirent.h>"
$ WRITE OUT "#include <errno.h>"
$ WRITE OUT "#include <stdio.h>"
$ WRITE OUT "#include <string.h>"
$ WRITE OUT ""
$ WRITE OUT "#include ""project.h"""
$ WRITE OUT ""
$ WRITE OUT "#define READ_BUFFER_SIZE 1024"
$ WRITE OUT ""
$ WRITE OUT "static int path_is_safe(const char *path)"
$ WRITE OUT "{"
$ WRITE OUT "    if (path == NULL || *path == '\0') {"
$ WRITE OUT "        return 0;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (strstr(path, "".."") != NULL) {"
$ WRITE OUT "        return 0;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (strchr(path, ':') != NULL) {"
$ WRITE OUT "        return 0;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (*path == '/' || *path == '\') {"
$ WRITE OUT "        return 0;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (strchr(path, '[') != NULL &&"
$ WRITE OUT "        strncmp(path, ""[."", 2U) != 0) {"
$ WRITE OUT "        return 0;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    return 1;"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static int is_old_version(const char *name)"
$ WRITE OUT "{"
$ WRITE OUT "    const char *semicolon;"
$ WRITE OUT "    const char *position;"
$ WRITE OUT ""
$ WRITE OUT "    semicolon = strrchr(name, ';');"
$ WRITE OUT ""
$ WRITE OUT "    if (semicolon == NULL || semicolon[1] == '\0') {"
$ WRITE OUT "        return 0;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    position = semicolon + 1;"
$ WRITE OUT ""
$ WRITE OUT "    while (*position != '\0') {"
$ WRITE OUT "        if (!isdigit((unsigned char)*position)) {"
$ WRITE OUT "            return 0;"
$ WRITE OUT "        }"
$ WRITE OUT "        ++position;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    return strcmp(semicolon, "";1"") != 0;"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static int hide_default_entry(const char *name)"
$ WRITE OUT "{"
$ WRITE OUT "    if (strcmp(name, ""."") == 0 ||"
$ WRITE OUT "        strcmp(name, "".."") == 0) {"
$ WRITE OUT "        return 1;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (strncmp(name, ""^.git"", 5U) == 0) {"
$ WRITE OUT "        return 1;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (is_old_version(name)) {"
$ WRITE OUT "        return 1;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    return 0;"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void project_show_root(const agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    if (state == NULL ||"
$ WRITE OUT "        state->project_root == NULL ||"
$ WRITE OUT "        *state->project_root == '\0') {"
$ WRITE OUT "        (void)puts(""OVMS_AGENT_ROOT is not defined."");"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    (void)printf(""Project root: %s\n"", state->project_root);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void project_show_status(const agent_state *state)"
$ WRITE OUT "{"
$ WRITE OUT "    if (state == NULL) {"
$ WRITE OUT "        (void)puts(""Agent state is unavailable."");"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    (void)printf(""Version:       %s\n"", OVMS_AGENT_VERSION);"
$ WRITE OUT "    (void)printf(""Project root:  %s\n"","
$ WRITE OUT "        state->project_root != NULL &&"
$ WRITE OUT "        *state->project_root != '\0'"
$ WRITE OUT "            ? state->project_root"
$ WRITE OUT "            : ""not defined"");"
$ WRITE OUT "    (void)printf(""API key:       %s\n"","
$ WRITE OUT "        state->api_key_defined ? ""defined"" : ""not defined"");"
$ WRITE OUT "    (void)printf(""Write access:  %s\n"","
$ WRITE OUT "        state->write_enabled ? ""enabled"" : ""disabled"");"
$ WRITE OUT "    (void)printf(""DCL execution: %s\n"","
$ WRITE OUT "        state->dcl_enabled ? ""enabled"" : ""disabled"");"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void project_list(const agent_state *state, int show_all)"
$ WRITE OUT "{"
$ WRITE OUT "    DIR *directory;"
$ WRITE OUT "    struct dirent *entry;"
$ WRITE OUT ""
$ WRITE OUT "    if (state == NULL ||"
$ WRITE OUT "        state->project_root == NULL ||"
$ WRITE OUT "        *state->project_root == '\0') {"
$ WRITE OUT "        (void)puts(""OVMS_AGENT_ROOT is not defined."");"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    directory = opendir(state->project_root);"
$ WRITE OUT ""
$ WRITE OUT "    if (directory == NULL) {"
$ WRITE OUT "        (void)printf(""Unable to open project root: %s\n"","
$ WRITE OUT "                     state->project_root);"
$ WRITE OUT "        (void)printf(""Reason: %s\n"", strerror(errno));"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    (void)printf(""Directory: %s\n\n"", state->project_root);"
$ WRITE OUT ""
$ WRITE OUT "    while ((entry = readdir(directory)) != NULL) {"
$ WRITE OUT "        if (show_all || !hide_default_entry(entry->d_name)) {"
$ WRITE OUT "            (void)printf(""%s\n"", entry->d_name);"
$ WRITE OUT "        }"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (closedir(directory) != 0) {"
$ WRITE OUT "        (void)printf(""Warning: unable to close directory: %s\n"","
$ WRITE OUT "                     strerror(errno));"
$ WRITE OUT "    }"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void project_read(const agent_state *state, const char *path)"
$ WRITE OUT "{"
$ WRITE OUT "    FILE *file;"
$ WRITE OUT "    char buffer[READ_BUFFER_SIZE];"
$ WRITE OUT "    unsigned long line_number;"
$ WRITE OUT ""
$ WRITE OUT "    if (state == NULL ||"
$ WRITE OUT "        state->project_root == NULL ||"
$ WRITE OUT "        *state->project_root == '\0') {"
$ WRITE OUT "        (void)puts(""OVMS_AGENT_ROOT is not defined."");"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (!path_is_safe(path)) {"
$ WRITE OUT "        (void)puts(""Unsafe or invalid project-relative path."");"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    file = fopen(path, ""r"");"
$ WRITE OUT ""
$ WRITE OUT "    if (file == NULL) {"
$ WRITE OUT "        (void)printf(""Unable to read %s\n"", path);"
$ WRITE OUT "        (void)printf(""Reason: %s\n"", strerror(errno));"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    line_number = 1UL;"
$ WRITE OUT ""
$ WRITE OUT "    while (fgets(buffer, sizeof(buffer), file) != NULL) {"
$ WRITE OUT "        (void)printf(""%6lu  %s"", line_number, buffer);"
$ WRITE OUT ""
$ WRITE OUT "        if (strchr(buffer, '\n') == NULL) {"
$ WRITE OUT "            (void)putchar('\n');"
$ WRITE OUT "        }"
$ WRITE OUT ""
$ WRITE OUT "        ++line_number;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (ferror(file)) {"
$ WRITE OUT "        (void)printf(""Read error: %s\n"", strerror(errno));"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (fclose(file) != 0) {"
$ WRITE OUT "        (void)printf(""Warning: unable to close file: %s\n"","
$ WRITE OUT "                     strerror(errno));"
$ WRITE OUT "    }"
$ WRITE OUT "}"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! COMMAND.H
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]COMMAND.H
$ WRITE OUT "#ifndef OVMS_AGENT_COMMAND_H"
$ WRITE OUT "#define OVMS_AGENT_COMMAND_H"
$ WRITE OUT ""
$ WRITE OUT "#include ""agent.h"""
$ WRITE OUT ""
$ WRITE OUT "void command_prompt(void);"
$ WRITE OUT "void command_execute(agent_state *state, char *input);"
$ WRITE OUT ""
$ WRITE OUT "#endif"
$ CLOSE OUT
$
$!---------------------------------------------------------------------
$! COMMAND.C
$!---------------------------------------------------------------------
$ OPEN/WRITE OUT [.SRC]COMMAND.C
$ WRITE OUT "#include <stdio.h>"
$ WRITE OUT "#include <string.h>"
$ WRITE OUT ""
$ WRITE OUT "#include ""command.h"""
$ WRITE OUT "#include ""project.h"""
$ WRITE OUT "#include ""util.h"""
$ WRITE OUT ""
$ WRITE OUT "typedef void (*command_handler)(agent_state *state,"
$ WRITE OUT "                                const char *arguments);"
$ WRITE OUT ""
$ WRITE OUT "typedef struct command_entry {"
$ WRITE OUT "    const char *name;"
$ WRITE OUT "    const char *description;"
$ WRITE OUT "    command_handler handler;"
$ WRITE OUT "} command_entry;"
$ WRITE OUT ""
$ WRITE OUT "static void command_help(agent_state *state, const char *arguments);"
$ WRITE OUT "static void command_version(agent_state *state, const char *arguments);"
$ WRITE OUT "static void command_root(agent_state *state, const char *arguments);"
$ WRITE OUT "static void command_status(agent_state *state, const char *arguments);"
$ WRITE OUT "static void command_list(agent_state *state, const char *arguments);"
$ WRITE OUT "static void command_read(agent_state *state, const char *arguments);"
$ WRITE OUT "static void command_quit(agent_state *state, const char *arguments);"
$ WRITE OUT ""
$ WRITE OUT "static const command_entry command_table[] = {"
$ WRITE OUT "    { ""HELP"",    ""Display command help"", command_help },"
$ WRITE OUT "    { ""VERSION"", ""Display agent version"", command_version },"
$ WRITE OUT "    { ""ROOT"",    ""Display the project root"", command_root },"
$ WRITE OUT "    { ""STATUS"",  ""Display agent status"", command_status },"
$ WRITE OUT "    { ""LIST"",    ""List project files; LIST/ALL shows all versions"","
$ WRITE OUT "      command_list },"
$ WRITE OUT "    { ""READ"",    ""Read a project-relative text file"", command_read },"
$ WRITE OUT "    { ""QUIT"",    ""Exit OVMS Agent"", command_quit },"
$ WRITE OUT "    { ""EXIT"",    ""Exit OVMS Agent"", command_quit },"
$ WRITE OUT "    { NULL, NULL, NULL }"
$ WRITE OUT "};"
$ WRITE OUT ""
$ WRITE OUT "void command_prompt(void)"
$ WRITE OUT "{"
$ WRITE OUT "    (void)fputs(""OVMS-AGENT> "", stdout);"
$ WRITE OUT "    (void)fflush(stdout);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "void command_execute(agent_state *state, char *input)"
$ WRITE OUT "{"
$ WRITE OUT "    const command_entry *entry;"
$ WRITE OUT "    char *command;"
$ WRITE OUT "    char *arguments;"
$ WRITE OUT "    char *position;"
$ WRITE OUT ""
$ WRITE OUT "    if (state == NULL || input == NULL) {"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    util_trim(input);"
$ WRITE OUT "    command = util_skip_space(input);"
$ WRITE OUT ""
$ WRITE OUT "    if (command == NULL || *command == '\0') {"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    position = command;"
$ WRITE OUT ""
$ WRITE OUT "    while (*position != '\0' && *position != ' ' && *position != '\t') {"
$ WRITE OUT "        ++position;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (*position != '\0') {"
$ WRITE OUT "        *position = '\0';"
$ WRITE OUT "        arguments = util_skip_space(position + 1);"
$ WRITE OUT "    } else {"
$ WRITE OUT "        arguments = position;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    util_uppercase(command);"
$ WRITE OUT ""
$ WRITE OUT "    for (entry = command_table; entry->name != NULL; ++entry) {"
$ WRITE OUT "        if (strcmp(command, entry->name) == 0) {"
$ WRITE OUT "            entry->handler(state, arguments);"
$ WRITE OUT "            return;"
$ WRITE OUT "        }"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    if (strcmp(command, ""LIST/ALL"") == 0) {"
$ WRITE OUT "        project_list(state, 1);"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    (void)printf(""Unknown command: %s\n"", command);"
$ WRITE OUT "    (void)puts(""Enter HELP for available commands."");"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_help(agent_state *state, const char *arguments)"
$ WRITE OUT "{"
$ WRITE OUT "    const command_entry *entry;"
$ WRITE OUT ""
$ WRITE OUT "    (void)state;"
$ WRITE OUT "    (void)arguments;"
$ WRITE OUT "    (void)puts(""Commands:"");"
$ WRITE OUT ""
$ WRITE OUT "    for (entry = command_table; entry->name != NULL; ++entry) {"
$ WRITE OUT "        if (strcmp(entry->name, ""EXIT"") != 0) {"
$ WRITE OUT "            (void)printf(""  %-10s %s\n"","
$ WRITE OUT "                         entry->name,"
$ WRITE OUT "                         entry->description);"
$ WRITE OUT "        }"
$ WRITE OUT "    }"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_version(agent_state *state,"
$ WRITE OUT "                            const char *arguments)"
$ WRITE OUT "{"
$ WRITE OUT "    (void)state;"
$ WRITE OUT "    (void)arguments;"
$ WRITE OUT "    (void)printf(""OVMS Agent %s\n"", OVMS_AGENT_VERSION);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_root(agent_state *state, const char *arguments)"
$ WRITE OUT "{"
$ WRITE OUT "    (void)arguments;"
$ WRITE OUT "    project_show_root(state);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_status(agent_state *state, const char *arguments)"
$ WRITE OUT "{"
$ WRITE OUT "    (void)arguments;"
$ WRITE OUT "    project_show_status(state);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_list(agent_state *state, const char *arguments)"
$ WRITE OUT "{"
$ WRITE OUT "    (void)arguments;"
$ WRITE OUT "    project_list(state, 0);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_read(agent_state *state, const char *arguments)"
$ WRITE OUT "{"
$ WRITE OUT "    if (arguments == NULL || *arguments == '\0') {"
$ WRITE OUT "        (void)puts(""Usage: READ project-relative-file"");"
$ WRITE OUT "        return;"
$ WRITE OUT "    }"
$ WRITE OUT ""
$ WRITE OUT "    project_read(state, arguments);"
$ WRITE OUT "}"
$ WRITE OUT ""
$ WRITE OUT "static void command_quit(agent_state *state, const char *arguments)"
$ WRITE OUT "{"
$ WRITE OUT "    (void)arguments;"
$ WRITE OUT "    agent_stop(state);"
$ WRITE OUT "}"
$ CLOSE OUT
$
$ WRITE SYS$OUTPUT ""
$ WRITE SYS$OUTPUT "Milestone 3 files created."
$ WRITE SYS$OUTPUT "Previous file versions remain available."
$ WRITE SYS$OUTPUT ""
$ WRITE SYS$OUTPUT "Next commands:"
$ WRITE SYS$OUTPUT "$ @BUILD"
$ WRITE SYS$OUTPUT "$ @OVMS_AGENT"
$ WRITE SYS$OUTPUT ""
$
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 1
