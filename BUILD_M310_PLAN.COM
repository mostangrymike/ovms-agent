$!===========================================================
$! BUILD_M310_PLAN.COM - M310 saved-plan lifecycle regression
$!===========================================================
$ SET NOON
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$ FINAL_STATUS = 1
$
$ IF F$SEARCH("[]BUILD.DIR;*") .EQS. ""
$ THEN
$     CREATE/DIRECTORY [.BUILD]
$     IF .NOT. $STATUS THEN GOTO FAILED
$ ENDIF
$
$ CC/OBJECT=[.BUILD]M310_PLAN_TEST.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]M310_PLAN_TEST.C
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ LINK/EXECUTABLE=[.BUILD]M310_PLAN_TEST.EXE -
[.BUILD]M310_PLAN_TEST.OBJ
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ RUN [.BUILD]M310_PLAN_TEST
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 1
$
$ FAILED:
$ FINAL_STATUS = $STATUS
$ WRITE SYS$ERROR "M310 saved-plan lifecycle/execution regression failed."
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 'FINAL_STATUS'
