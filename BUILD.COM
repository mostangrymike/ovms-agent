$!-----------------------------------------------------------
$! Build M218 repair configuration display test.
$!-----------------------------------------------------------
$ CC/OBJECT=[.BUILD]M218_REPAIR_CONFIG_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]M218_REPAIR_CONFIG_TEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ LINK/EXECUTABLE=[.BUILD]M218_REPAIR_CONFIG_TEST.EXE -
[.BUILD]M218_REPAIR_CONFIG_TEST.OBJ, -
[.BUILD]AGENT.OBJ, -
[.BUILD]COMMAND_MODULES.OPT/OPTIONS, -
[.BUILD]PROJECT.OBJ, -
[.BUILD]OPENAI_MODULES.OPT/OPTIONS, -
[.BUILD]EDIT.OBJ, -
[.BUILD]UTIL.OBJ
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     WRITE SYS$ERROR "Link failed for M218_REPAIR_CONFIG_TEST.EXE."
$     GOTO FINISH
$ ENDIF
$
$ RUN [.BUILD]M218_REPAIR_CONFIG_TEST
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     WRITE SYS$ERROR "Regression test M218_REPAIR_CONFIG_TEST.EXE failed."
$     GOTO FINISH
$ ENDIF
$
