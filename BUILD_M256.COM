$! BUILD_M256.COM - Phase 5 session-resumption evidence
$ SET NOON
$
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
                F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$
$ FINAL_STATUS = 1
$
$ WRITE SYS$OUTPUT "Running M256 session-resumption regressions..."
$
$ IF F$SEARCH("[.BUILD]M228_SESSION_TEST.EXE;*") .EQS. ""
$ THEN
$     WRITE SYS$OUTPUT "M256 requires a successful @BUILD first."
$     FINAL_STATUS = %X10000002
$     GOTO FINISH
$ ENDIF
$
$ RUN [.BUILD]M228_SESSION_TEST
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     WRITE SYS$OUTPUT "M256 M228 persistent-session foundation evidence failed."
$     GOTO FINISH
$ ENDIF
$
$ WRITE SYS$OUTPUT "M256 M228 persistent-session foundation evidence passed."
$
$!-----------------------------------------------------------
$! M256.2/M256.3 resumed-session approval + checkpoint safety.
$!-----------------------------------------------------------
$ CC/OBJECT=[.BUILD]M256_RESUME_APPROVAL_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]M256_RESUME_APPROVAL_TEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ LINK/EXECUTABLE=[.BUILD]M256_RESUME_APPROVAL_TEST.EXE -
[.BUILD]M256_RESUME_APPROVAL_TEST.OBJ, -
[.BUILD]AGENT.OBJ, -
[.BUILD]COMMAND_MODULES.OPT/OPTIONS, -
[.BUILD]PROJECT.OBJ, -
[.BUILD]OPENAI_MODULES.OPT/OPTIONS, -
[.BUILD]EDIT.OBJ, -
[.BUILD]UTIL.OBJ
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     WRITE SYS$OUTPUT "Link failed for M256_RESUME_APPROVAL_TEST.EXE."
$     GOTO FINISH
$ ENDIF
$
$ RUN [.BUILD]M256_RESUME_APPROVAL_TEST
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     WRITE SYS$OUTPUT "M256 resumed-session checkpoint evidence failed."
$     GOTO FINISH
$ ENDIF
$
$ WRITE SYS$OUTPUT "M256 resumed-session reapproval/checkpoint evidence passed."
$ WRITE SYS$OUTPUT "M256 stale planned-file resume refusal evidence passed."
$
$!-----------------------------------------------------------
$! M256.4 true process-boundary restart/resume evidence.
$!-----------------------------------------------------------
$ CC/OBJECT=[.BUILD]M256_RESTART_SETUP_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]M256_RESTART_SETUP_TEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ LINK/EXECUTABLE=[.BUILD]M256_RESTART_SETUP_TEST.EXE -
[.BUILD]M256_RESTART_SETUP_TEST.OBJ, -
[.BUILD]AGENT.OBJ, -
[.BUILD]COMMAND_MODULES.OPT/OPTIONS, -
[.BUILD]PROJECT.OBJ, -
[.BUILD]OPENAI_MODULES.OPT/OPTIONS, -
[.BUILD]EDIT.OBJ, -
[.BUILD]UTIL.OBJ
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     WRITE SYS$OUTPUT "Link failed for M256_RESTART_SETUP_TEST.EXE."
$     GOTO FINISH
$ ENDIF
$
$ CC/OBJECT=[.BUILD]M256_RESTART_RESUME_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]M256_RESTART_RESUME_TEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ LINK/EXECUTABLE=[.BUILD]M256_RESTART_RESUME_TEST.EXE -
[.BUILD]M256_RESTART_RESUME_TEST.OBJ, -
[.BUILD]AGENT.OBJ, -
[.BUILD]COMMAND_MODULES.OPT/OPTIONS, -
[.BUILD]PROJECT.OBJ, -
[.BUILD]OPENAI_MODULES.OPT/OPTIONS, -
[.BUILD]EDIT.OBJ, -
[.BUILD]UTIL.OBJ
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     WRITE SYS$OUTPUT "Link failed for M256_RESTART_RESUME_TEST.EXE."
$     GOTO FINISH
$ ENDIF
$
$ RUN [.BUILD]M256_RESTART_SETUP_TEST
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     WRITE SYS$OUTPUT "M256 restart setup evidence failed."
$     GOTO FINISH
$ ENDIF
$
$ RUN [.BUILD]M256_RESTART_RESUME_TEST
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     WRITE SYS$OUTPUT "M256 cross-process restart/resume evidence failed."
$     GOTO FINISH
$ ENDIF
$
$ WRITE SYS$OUTPUT "M256 cross-process restart/resume evidence passed."
$ WRITE SYS$OUTPUT "All M256 session-resumption regressions passed."
$ GOTO FINISH
$
$COMPILE_ERROR:
$ FINAL_STATUS = $STATUS
$ WRITE SYS$OUTPUT "M256 focused regression compilation failed."
$
$FINISH:
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 'FINAL_STATUS'
