$! Start OVMS Agent
$ SET NOON

$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
                F$PARSE(PROCEDURE,,,"DIRECTORY")
$ IMAGE = PROJECT_DIR + "OVMS_AGENT.EXE"

$ IF F$SEARCH(IMAGE) .EQS. ""
$ THEN
$     WRITE SYS$ERROR "%OVMS-AGENT-E-NOIMAGE, OVMS_AGENT.EXE was not found"
$     WRITE SYS$ERROR "Run @BUILD first."
$     EXIT %X10000002
$ ENDIF

$ RUN 'IMAGE'
$ EXIT $STATUS
