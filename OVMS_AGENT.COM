$ SET NOON
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
                F$PARSE(PROCEDURE,,,"DIRECTORY")
$ IMAGE = F$PARSE("[.BUILD]OVMS_AGENT.EXE", PROJECT_DIR)

$ IF F$SEARCH(IMAGE) .EQS. ""
$ THEN
$     WRITE SYS$ERROR "%OVMS-AGENT-E-NOIMAGE, executable not found"
$     WRITE SYS$ERROR "Run @BUILD first."
$     EXIT %X10000002
$ ENDIF

$ DEFINE/USER SYS$INPUT SYS$COMMAND
$ DEFINE/USER SYS$OUTPUT SYS$COMMAND
$ RUN 'IMAGE'
$ EXIT $STATUS
