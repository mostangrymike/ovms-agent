$!===========================================================
$! BUILD_LLM_MODULES.COM
$! Compile the modular LLM/agent subsystem.
$!===========================================================
$ SET NOON
$ FINAL_STATUS = 1
$
$ WRITE SYS$OUTPUT "Compiling modular LLM subsystem..."
$
$ CC/OBJECT=[.BUILD]OPENAI_REPAIR.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]OPENAI_REPAIR.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]LLM_TOOL_SCHEMA.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_TOOL_SCHEMA.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]LLM_JSON_WRITE.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_JSON_WRITE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]LLM_AGENT_CTX.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_AGENT_CTX.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]LLM_PROMPTS.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_PROMPTS.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_STATE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_STATE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_JSON.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_JSON.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_JSON_PARSE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_JSON_PARSE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_REQUEST.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_REQUEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_IMAGE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_IMAGE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_REQ_IMAGE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_REQ_IMAGE_M259.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_REQUEST_BASIC.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_REQUEST_BASIC.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_TRANSPORT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_TRANSPORT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_RESPONSE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_RESPONSE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! M264 COBOL structural guard and focused regression.
$ CC/OBJECT=[.BUILD]COBOL_GUARD.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]COBOL_GUARD.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]M264_COBOL_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]M264_COBOL_TEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ LINK/EXECUTABLE=[.BUILD]M264_COBOL_TEST.EXE -
[.BUILD]M264_COBOL_TEST.OBJ, -
[.BUILD]COBOL_GUARD.OBJ
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ RUN [.BUILD]M264_COBOL_TEST
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! RMS writer is required by the M265 regression below. Compile it here
$! so a clean build never depends on a stale [.BUILD]RMS_WRITE.OBJ.
$ CC/OBJECT=[.BUILD]RMS_WRITE.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]RMS_WRITE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! M265 GAP-008 RMS-aware Git restore and focused regression.
$ CC/OBJECT=[.BUILD]GIT_RMS_RESTORE.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]GIT_RMS_RESTORE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]M265_GIT_RMS_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]M265_GIT_RMS_TEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ LINK/EXECUTABLE=[.BUILD]M265_GIT_RMS_TEST.EXE -
[.BUILD]M265_GIT_RMS_TEST.OBJ, -
[.BUILD]GIT_RMS_RESTORE.OBJ, -
[.BUILD]RMS_WRITE.OBJ
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ RUN [.BUILD]M265_GIT_RMS_TEST
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_TOOLS.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_TOOLS_M264.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_TOOL_REGISTRY.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_TOOL_REGISTRY.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_AGENT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_AGENT_M259.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_AGENT_LOOP.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_AGENT_LOOP_M259.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_BUILD.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_BUILD.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_CREATE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_CREATE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_RETRY.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_RETRY.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_STATUS.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_STATUS.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_EXECUTE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_EXECUTE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_PLAN.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_PLAN.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_LOG.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_LOG.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_NETWORK.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_NETWORK.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_PARITY.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_PARITY_M258.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_SESSION.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_SESSION_M256.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_TRANSCRIPT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_TRANSCRIPT_M265.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_AUTO.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_AUTO.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_CONTEXT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_CONTEXT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_INSTRUCTIONS.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_INSTRUCTIONS.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_PROJECT_MAP.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_PROJECT_MAP.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_GIT_CONTEXT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_GIT_CONTEXT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]OPENAI_PATCH.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]OPENAI_PATCH.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_TOOL_RESULT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_TOOL_RESULT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! Recompile RMS writer in its canonical module position for the final link.
$ CC/OBJECT=[.BUILD]RMS_WRITE.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]RMS_WRITE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]EDIT_TXN.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]EDIT_TXN.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]OPENAI_REQUEST_AGENT.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]OPENAI_REQUEST_AGENT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]OPENAI_REQUEST_BUILD.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]OPENAI_REQUEST_BUILD.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ WRITE SYS$OUTPUT "Modular LLM subsystem compiled successfully."
$ EXIT 1
$
$ COMPILE_ERROR:
$ FINAL_STATUS = $STATUS
$ WRITE SYS$ERROR "Modular LLM subsystem compilation failed."
$ EXIT 'FINAL_STATUS'
