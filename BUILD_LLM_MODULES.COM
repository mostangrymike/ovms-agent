$!===========================================================
$! BUILD_LLM_MODULES.COM
$! Compile the modular LLM/agent subsystem.
$!===========================================================
$ SET NOON
$ FINAL_STATUS = 1
$
$ WRITE SYS$OUTPUT "Compiling modular LLM subsystem..."
$
$! M280 persistent settings are shared by startup, request, and network
$! consumers. Compile the object here so a clean LLM build never depends on
$! a stale object from the later command-module phase.
$ CC/OBJECT=[.BUILD]SETTINGS.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]SETTINGS.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! M273 terminal presentation module and hard plain-output regressions.
$ @BUILD_M273_ANSI
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_REPAIR.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_REPAIR.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]LLM_TOOL_SCHEMA.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_TOOL_SCHEMA.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]LLM_JSON_WRITE.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_JSON_WRITE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]LLM_AGENT_CTX.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_AGENT_CTX.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! M288 shared language-knowledge loader and provider-free regression.
$ CC/OBJECT=[.BUILD]LLM_LANGUAGE.OBJ -
     /STANDARD=RELAXED_ANSI89 -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_LANGUAGE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]M288_LANGUAGE_TEST.OBJ -
     /STANDARD=RELAXED_ANSI89 -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]M288_LANGUAGE_TEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ LINK/EXECUTABLE=[.BUILD]M288_LANGUAGE_TEST.EXE -
     [.BUILD]M288_LANGUAGE_TEST.OBJ, -
     [.BUILD]LLM_LANGUAGE.OBJ
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ DEFINE/USER OVMS_AGENT_LANGUAGE_DIR "[.LANGUAGE]"
$ RUN [.BUILD]M288_LANGUAGE_TEST
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! M289 native build-profile parser/resolver regression.
$ @BUILD_M289_PROFILE
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_PROMPTS.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_PROMPTS.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_CORE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_CORE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_STATE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_STATE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_JSON.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_JSON.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_JSON_PARSE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_JSON_PARSE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_REQUEST.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_REQUEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_IMAGE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_IMAGE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_REQUEST_IMAGE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_REQUEST_IMAGE_M259.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_REQUEST_BASIC.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_REQUEST_BASIC.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! M273 wraps the accepted transport core only to capture provider-supplied
$! usage from the completed response. The SSE/pipe implementation itself
$! remains unchanged after Phase 5 VAX acceptance.
$ CC/OBJECT=[.BUILD]LLM_TRANSPORT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_TRANSPORT_M273.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_RESPONSE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_RESPONSE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! M264 COBOL structural guard and focused regression.
$ CC/OBJECT=[.BUILD]COBOL_GUARD.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]COBOL_GUARD.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]M264_COBOL_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]M264_COBOL_TEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ LINK/EXECUTABLE=[.BUILD]M264_COBOL_TEST.EXE -
[.BUILD]M264_COBOL_TEST.OBJ, -
[.BUILD]COBOL_GUARD.OBJ
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ RUN [.BUILD]M264_COBOL_TEST
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! RMS writer is required by the M265 regression below. Compile it here
$! so a clean build never depends on a stale [.BUILD]RMS_WRITE.OBJ.
$ CC/OBJECT=[.BUILD]RMS_WRITE.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]RMS_WRITE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! M265 GAP-008 RMS-aware Git restore and focused regression.
$ CC/OBJECT=[.BUILD]GIT_RMS_RESTORE.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]GIT_RMS_RESTORE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]M265_GIT_RMS_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]M265_GIT_RMS_TEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ LINK/EXECUTABLE=[.BUILD]M265_GIT_RMS_TEST.EXE -
[.BUILD]M265_GIT_RMS_TEST.OBJ, -
[.BUILD]GIT_RMS_RESTORE.OBJ, -
[.BUILD]RMS_WRITE.OBJ
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ RUN [.BUILD]M265_GIT_RMS_TEST
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! M275 deterministic regressions for #83 raw tool arguments and
$! #84 nested RMS-aware Git restore path resolution.
$ CC/OBJECT=[.BUILD]M275_BACKLOG_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]M275_BACKLOG_TEST.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ LINK/EXECUTABLE=[.BUILD]M275_BACKLOG_TEST.EXE -
[.BUILD]M275_BACKLOG_TEST.OBJ, -
[.BUILD]GIT_RMS_RESTORE.OBJ, -
[.BUILD]RMS_WRITE.OBJ
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ RUN [.BUILD]M275_BACKLOG_TEST
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_TOOLS.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_TOOLS_M264.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_TOOL_REGISTRY.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_TOOL_REGISTRY.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_AGENT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_AGENT_M259.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_AGENT_LOOP.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_AGENT_LOOP_M259.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_BUILD.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_BUILD.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_CREATE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_CREATE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_RETRY.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_RETRY_M273.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_STATUS.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_STATUS.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_EXECUTE.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_EXECUTE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_PLAN.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_PLAN_M273.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_LOG.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_LOG.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_NETWORK.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_NETWORK.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_PARITY.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_PARITY_M258.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_SESSION.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_SESSION_M256.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_TRANSCRIPT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_TRANSCRIPT_M265.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_AUTO.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_AUTO.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_CONTEXT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_CONTEXT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_INSTRUCTIONS.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_INSTRUCTIONS.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_PROJECT_MAP.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_PROJECT_MAP.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_GIT_CONTEXT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_GIT_CONTEXT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_PATCH.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_PATCH.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]LLM_TOOL_RESULT.OBJ -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]LLM_TOOL_RESULT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$! Recompile RMS writer in its canonical module position for the final link.
$ CC/OBJECT=[.BUILD]RMS_WRITE.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]RMS_WRITE.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ CC/OBJECT=[.BUILD]EDIT_TXN.OBJ -
/STANDARD=C99 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]EDIT_TXN.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]LLM_REQUEST_AGENT.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_REQUEST_AGENT.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$ CC/OBJECT=[.BUILD]LLM_REQUEST_BUILD.OBJ -
     /INCLUDE=([.SRC]) -
     /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
     [.SRC]LLM_REQUEST_BUILD.C
$ IF .NOT. $STATUS THEN GOTO COMPILE_ERROR
$
$ WRITE SYS$OUTPUT "Modular LLM subsystem compiled successfully."
$ EXIT 1
$
$ COMPILE_ERROR:
$ FINAL_STATUS = $STATUS
$ WRITE SYS$ERROR "Modular LLM subsystem compilation failed."
$ EXIT 'FINAL_STATUS'