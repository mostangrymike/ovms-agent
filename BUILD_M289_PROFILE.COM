$!===========================================================
$! BUILD_M289_PROFILE.COM
$! Compile and run the M289 build-profile parser/resolver regression.
$! Native OpenVMS execution only.
$!===========================================================
$ SET NOON
$ FINAL_STATUS = 1
$
$ CC/OBJECT=[.BUILD]M289_BUILD_PROFILE.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]M289_BUILD_PROFILE.C
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ CC/OBJECT=[.BUILD]M289_BUILD_PROFILE_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/INCLUDE=([.SRC]) -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]M289_BUILD_PROFILE_TEST.C
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ LINK/EXECUTABLE=[.BUILD]M289_BUILD_PROFILE_TEST.EXE -
[.BUILD]M289_BUILD_PROFILE_TEST.OBJ, -
[.BUILD]M289_BUILD_PROFILE.OBJ
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ RUN [.BUILD]M289_BUILD_PROFILE_TEST.EXE
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ WRITE SYS$OUTPUT "M289 native profile regression passed."
$ EXIT 1
$
$ FAILED:
$ FINAL_STATUS = $STATUS
$ WRITE SYS$ERROR "M289 native profile regression failed."
$ EXIT 'FINAL_STATUS'
