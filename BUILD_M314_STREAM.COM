$!===========================================================
$! BUILD_M314_STREAM.COM - M314 pclose completion regression
$!===========================================================
$ SET NOON
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$ FINAL_STATUS = 1
$
$ IF F$SEARCH("[]BUILD.DIR;*") .EQS. ""
$ THEN
$     CREATE/DIRECTORY [.BUILD]
$     IF .NOT. $STATUS THEN GOTO FAILED
$ ENDIF
$
$ IF F$SEARCH("[.BUILD]M314_PCLOSE_OK.COM;*") .NES. "" THEN -
DELETE/NOLOG [.BUILD]M314_PCLOSE_OK.COM;*
$ OPEN/WRITE OK [.BUILD]M314_PCLOSE_OK.COM
$ IF .NOT. $STATUS THEN GOTO FAILED
$ WRITE OK "$ WRITE SYS$OUTPUT ""M314_OK"""
$ WRITE OK "$ EXIT 1"
$ CLOSE OK
$
$ IF F$SEARCH("[.BUILD]M314_PCLOSE_FAIL.COM;*") .NES. "" THEN -
DELETE/NOLOG [.BUILD]M314_PCLOSE_FAIL.COM;*
$ OPEN/WRITE BAD [.BUILD]M314_PCLOSE_FAIL.COM
$ IF .NOT. $STATUS THEN GOTO FAILED
$ WRITE BAD "$ WRITE SYS$OUTPUT ""M314_FAIL"""
$ WRITE BAD "$ EXIT 2"
$ CLOSE BAD
$
$ CC/OBJECT=[.BUILD]M314_PCLOSE_TEST.OBJ -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]M314_PCLOSE_TEST.C
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ LINK/EXECUTABLE=[.BUILD]M314_PCLOSE_TEST.EXE -
[.BUILD]M314_PCLOSE_TEST.OBJ
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ DEFINE/USER DECC$STREAM_PIPE ENABLE
$ RUN [.BUILD]M314_PCLOSE_TEST
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ DELETE/NOLOG [.BUILD]M314_PCLOSE_OK.COM;*
$ DELETE/NOLOG [.BUILD]M314_PCLOSE_FAIL.COM;*
$ WRITE SYS$OUTPUT "M314 stream completion regression passed."
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 1
$
$ FAILED:
$ FINAL_STATUS = $STATUS
$ IF FINAL_STATUS .AND. 1 THEN FINAL_STATUS = 2
$ IF F$SEARCH("[.BUILD]M314_PCLOSE_OK.COM;*") .NES. "" THEN -
DELETE/NOLOG [.BUILD]M314_PCLOSE_OK.COM;*
$ IF F$SEARCH("[.BUILD]M314_PCLOSE_FAIL.COM;*") .NES. "" THEN -
DELETE/NOLOG [.BUILD]M314_PCLOSE_FAIL.COM;*
$ WRITE SYS$ERROR "M314 stream completion regression failed."
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 'FINAL_STATUS'
