$! M268 focused AUTOPILOT policy/budget acceptance.
$ SET NOON
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$ FINAL_STATUS = 1
$
$ WRITE SYS$OUTPUT "Building M268 AUTOPILOT focused regression..."
$ CC/OBJECT=[.BUILD]M268_AUTOPILOT_TEST.OBJ -
 /STANDARD=RELAXED_ANSI89 -
 /PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
 /INCLUDE_DIRECTORY=([.SRC]) -
 [.SRC]M268_AUTOPILOT_TEST.C
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     GOTO FINISH
$ ENDIF
$
$ LINK/EXECUTABLE=[.BUILD]M268_AUTOPILOT_TEST.EXE -
 [.BUILD]M268_AUTOPILOT_TEST.OBJ, -
 [.BUILD]AGENT.OBJ, -
 [.BUILD]COMMAND_MODULES.OPT/OPTIONS, -
 [.BUILD]PROJECT.OBJ, -
 [.BUILD]LLM_MODULES.OPT/OPTIONS, -
 [.BUILD]EDIT.OBJ, -
 [.BUILD]UTIL.OBJ
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     GOTO FINISH
$ ENDIF
$
$ RUN [.BUILD]M268_AUTOPILOT_TEST
$ FINAL_STATUS = $STATUS
$
$FINISH:
$ SET DEFAULT 'SAVED_DEFAULT'
$ WRITE SYS$OUTPUT "M268_AUTOPILOT_TEST_STATUS=''FINAL_STATUS'"
$ EXIT 'FINAL_STATUS'
