$!===========================================================
$! BUILD_M259_LIVE.COM - prepare controlled Phase 8 live image
$!===========================================================
$ SET NOON
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
                F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$ FINAL_STATUS = 1
$
$ CC/OBJECT=[.BUILD]M259_LIVE_FIXTURE.OBJ -
/STANDARD=RELAXED_ANSI89 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
[.SRC]M259_LIVE_FIXTURE.C
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     GOTO FINISH
$ ENDIF
$
$ LINK/EXECUTABLE=[.BUILD]M259_LIVE_FIXTURE.EXE -
[.BUILD]M259_LIVE_FIXTURE.OBJ
$ IF .NOT. $STATUS
$ THEN
$     FINAL_STATUS = $STATUS
$     GOTO FINISH
$ ENDIF
$
$ IF F$SEARCH("[]M259_LIVE.PNG;*") .NES. "" THEN DELETE []M259_LIVE.PNG;*
$ RUN [.BUILD]M259_LIVE_FIXTURE
$ FINAL_STATUS = $STATUS
$ IF .NOT. FINAL_STATUS THEN GOTO FINISH
$
$ WRITE SYS$OUTPUT ""
$ WRITE SYS$OUTPUT "Controlled live image is ready: M259_LIVE.PNG"
$ WRITE SYS$OUTPUT "Run @OVMS_AGENT and enter:"
$ WRITE SYS$OUTPUT "  AGENT/IMAGE M259_LIVE.PNG What is the dominant color of this image? Answer with the color and one short sentence."
$ WRITE SYS$OUTPUT "Then enter QUIT and delete the fixture with:"
$ WRITE SYS$OUTPUT "  DELETE M259_LIVE.PNG;*"
$
$FINISH:
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 'FINAL_STATUS'
