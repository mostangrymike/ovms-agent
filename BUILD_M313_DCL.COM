$!===========================================================
$! BUILD_M313_DCL.COM - M313 DCL generation/repair regression
$!===========================================================
$ SET NOON
$ SAVED_DEFAULT = F$ENVIRONMENT("DEFAULT")
$ PROCEDURE = F$ENVIRONMENT("PROCEDURE")
$ PROJECT_DIR = F$PARSE(PROCEDURE,,,"DEVICE") + -
F$PARSE(PROCEDURE,,,"DIRECTORY")
$ SET DEFAULT 'PROJECT_DIR'
$ FINAL_STATUS = 1
$
$ IF F$SEARCH("[]BUILD.DIR;*") .EQS. ""
$ THEN
$     CREATE/DIRECTORY [.BUILD]
$     IF .NOT. $STATUS THEN GOTO FAILED
$ ENDIF
$
$ CC/OBJECT=[.BUILD]M313_DCL_TEST.OBJ -
/STANDARD=RELAXED_ANSI89 -
/PREFIX_LIBRARY_ENTRIES=ALL_ENTRIES -
/INCLUDE_DIRECTORY=([.SRC]) -
[.SRC]M313_DCL_TEST.C
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ LINK/EXECUTABLE=[.BUILD]M313_DCL_TEST.EXE -
[.BUILD]M313_DCL_TEST.OBJ
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ RUN [.BUILD]M313_DCL_TEST
$ IF .NOT. $STATUS THEN GOTO FAILED
$
$ IF F$SEARCH("[.BUILD]M313_STATUS_MARKER.TXT;*") .NES. "" THEN -
DELETE/NOLOG [.BUILD]M313_STATUS_MARKER.TXT;*
$ @M313_STATUS_TEST
$ CHILD_STATUS = $STATUS
$ IF CHILD_STATUS .AND. 1 THEN GOTO EXPECTED_FAILED
$ IF F$SEARCH("[.BUILD]M313_STATUS_MARKER.TXT;*") .EQS. "" THEN GOTO EXPECTED_FAILED
$ SEARCH [.BUILD]M313_STATUS_MARKER.TXT "M313_STATUS_HANDLER_REACHED"
$ IF .NOT. $STATUS THEN GOTO FAILED
$ DELETE/NOLOG [.BUILD]M313_STATUS_MARKER.TXT;*
$ WRITE SYS$OUTPUT "M313 native SET NOON status regression passed."
$
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 1
$
$ EXPECTED_FAILED:
$ FINAL_STATUS = 2
$ GOTO FAILED_COMMON
$
$ FAILED:
$ FINAL_STATUS = $STATUS
$ IF FINAL_STATUS .AND. 1 THEN FINAL_STATUS = 2
$ FAILED_COMMON:
$ IF F$SEARCH("[.BUILD]M313_STATUS_MARKER.TXT;*") .NES. "" THEN -
DELETE/NOLOG [.BUILD]M313_STATUS_MARKER.TXT;*
$ WRITE SYS$ERROR "M313 DCL regression failed."
$ SET DEFAULT 'SAVED_DEFAULT'
$ EXIT 'FINAL_STATUS'
